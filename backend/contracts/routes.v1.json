{
  "schemaVersion": "jovra.backend-contracts/1",
  "status": "contract for S82 (gateway) and S97 (iOS client); nothing is provisioned (ADR-0014)",
  "source": "docs/backend/architecture.md §5 and §5.1; docs/backend/security-model.md §8",
  "basePath": "/v1 (user gateway), /internal/v1 (jovra-internal), /s (share links)",
  "descriptors": "Fixtures are HTTP exchange descriptors: a request is {pathParams?, query?, headers, body?}, a response is {status, headers, body?}. Bytes bodies are not in descriptors.",
  "errorCodes": [
    {
      "code": "unauthorized",
      "status": 401,
      "basis": "INFERRED from P0401; missing, malformed, expired or wrong-environment credential"
    },
    {
      "code": "demo_not_accepted",
      "status": 401,
      "basis": "architecture §2 rule 1 (T-GW-03)"
    },
    {
      "code": "reauth_required",
      "status": 401,
      "basis": "architecture §5.1 deletion-requests; security-model §2.2"
    },
    {
      "code": "budget_exceeded",
      "status": 402,
      "basis": "INFERRED from P0402"
    },
    {
      "code": "not_found",
      "status": 404,
      "basis": "architecture §5 envelope: also returned for an object the caller may not see"
    },
    {
      "code": "conflict",
      "status": 409,
      "basis": "INFERRED from P0409; wrong state, slot taken, stale or fenced"
    },
    {
      "code": "already_claimed",
      "status": 409,
      "basis": "architecture §5.1 attempt claim"
    },
    {
      "code": "parts_mismatch",
      "status": 409,
      "basis": "architecture §6.3 rule 4"
    },
    {
      "code": "requote_required",
      "status": 409,
      "basis": "architecture §5.1 job review"
    },
    {
      "code": "dependents",
      "status": 409,
      "basis": "architecture §5.1 deletion-requests"
    },
    {
      "code": "secret_not_replayable",
      "status": 409,
      "basis": "architecture §5 idempotency"
    },
    {
      "code": "expired",
      "status": 410,
      "basis": "INFERRED from P0410"
    },
    {
      "code": "range_not_satisfiable",
      "status": 416,
      "basis": "INFERRED; RFC 9110 §15.5.17 for a Range outside the object"
    },
    {
      "code": "invalid",
      "status": 422,
      "basis": "INFERRED from P0422; the request does not match its schema or a server-held expectation"
    },
    {
      "code": "idempotency_key_reused",
      "status": 422,
      "basis": "architecture §5 idempotency"
    },
    {
      "code": "rate_limited",
      "status": 429,
      "basis": "INFERRED from the §5 rate limits and P0429 quotas"
    },
    {
      "code": "internal",
      "status": 500,
      "basis": "INFERRED; never carries detail"
    }
  ],
