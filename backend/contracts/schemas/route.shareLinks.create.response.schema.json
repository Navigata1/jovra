{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/artifacts/{artifactId}/share-links response",
  "description": "shareLinks.create: a response descriptor (status, headers, body). Success body: JSON. Every response carries X-Request-Id; a JSON body's requestId equals it.",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "success": {
      "description": "Success: 200 with the §5 envelope {data, requestId}.",
      "type": "object",
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": 200
        },
        "headers": {
          "$ref": "common.schema.json#/$defs/jsonResponseHeaders"
        },
        "body": {
          "type": "object",
          "required": [
            "data",
            "requestId"
          ],
          "additionalProperties": false,
          "properties": {
            "data": {
              "$ref": "#/$defs/data"
            },
            "requestId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "clientRequestId": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          }
        }
      }
    },
    "error": {
      "description": "An error: the §5 envelope with one of this route's codes at its HTTP status.",
      "type": "object",
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            401,
            404,
            409,
            422,
            429,
            500
          ]
        },
        "headers": {
          "$ref": "common.schema.json#/$defs/jsonResponseHeaders"
        },
        "body": {
          "$ref": "common.schema.json#/$defs/errorBody"
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": 401
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "unauthorized",
                        "demo_not_accepted"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 404
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "not_found"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 409
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "conflict",
                        "secret_not_replayable"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 422
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "invalid",
                        "idempotency_key_reused"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 429
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "rate_limited"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 500
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "internal"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "data": {
      "type": "object",
      "required": [
        "shareLinkId",
        "url",
        "expiresAt"
      ],
      "additionalProperties": false,
      "properties": {
        "shareLinkId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "url": {
          "description": "The share URL; the jvh_ token is in the path and is returned once.",
          "type": "string",
          "maxLength": 512,
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?/s/jvh_[A-Za-z0-9_-]{43}$"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/dateTime"
        }
      }
    }
  }
}
