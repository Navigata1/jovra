{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /v1/jobs/{jobId} response",
  "description": "jobs.get: a response descriptor (status, headers, body). Success body: JSON. Every response carries X-Request-Id; a JSON body's requestId equals it.",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "success": {
      "description": "Success: 200 with the §5 envelope {data, requestId}.",
      "type": "object",
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": 200
        },
        "headers": {
          "$ref": "common.schema.json#/$defs/jsonResponseHeaders"
        },
        "body": {
          "type": "object",
          "required": [
            "data",
            "requestId"
          ],
          "additionalProperties": false,
          "properties": {
            "data": {
              "$ref": "#/$defs/data"
            },
            "requestId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "clientRequestId": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          }
        }
      }
    },
    "error": {
      "description": "An error: the §5 envelope with one of this route's codes at its HTTP status.",
      "type": "object",
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            401,
            404,
            500
          ]
        },
        "headers": {
          "$ref": "common.schema.json#/$defs/jsonResponseHeaders"
        },
        "body": {
          "$ref": "common.schema.json#/$defs/errorBody"
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": 401
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "unauthorized",
                        "demo_not_accepted"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 404
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "not_found"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 500
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "internal"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "data": {
      "type": "object",
      "required": [
        "state",
        "stage",
        "stageProgressMilli",
        "errorCode",
        "stages",
        "artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/jobState"
        },
        "stage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/jobStage"
            }
          ]
        },
        "stageProgressMilli": {
          "description": "Progress of the current stage only, 0 to 1000.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          ]
        },
        "errorCode": {
          "description": "render_jobs.error_code (INFERRED field).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/machineCode"
            }
          ]
        },
        "stages": {
          "description": "One entry per stage attempt so far (INFERRED shape).",
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "stage",
              "attempt",
              "state"
            ],
            "additionalProperties": false,
            "properties": {
              "stage": {
                "$ref": "common.schema.json#/$defs/jobStage"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "state": {
                "$ref": "common.schema.json#/$defs/attemptState"
              }
            }
          }
        },
        "artifacts": {
          "description": "Artifacts the caller may see (INFERRED shape).",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "artifactId",
              "kind",
              "state",
              "stale",
              "displayTitle",
              "bytes"
            ],
            "additionalProperties": false,
            "properties": {
              "artifactId": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "kind": {
                "$ref": "common.schema.json#/$defs/artifactKind"
              },
              "state": {
                "$ref": "common.schema.json#/$defs/artifactState"
              },
              "stale": {
                "type": "boolean"
              },
              "displayTitle": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "common.schema.json#/$defs/displayTitle"
                  }
                ]
              },
              "bytes": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            }
          }
        },
        "usage": {
          "description": "Owner only: coaches never see money (T-DB-25).",
          "type": "object",
          "required": [
            "estimate",
            "cap",
            "actual"
          ],
          "additionalProperties": false,
          "properties": {
            "estimate": {
              "type": "object",
              "required": [
                "lowCredits",
                "highCredits"
              ],
              "additionalProperties": false,
              "properties": {
                "lowCredits": {
                  "$ref": "common.schema.json#/$defs/credits"
                },
                "highCredits": {
                  "$ref": "common.schema.json#/$defs/credits"
                }
              }
            },
            "cap": {
              "$ref": "common.schema.json#/$defs/credits"
            },
            "actual": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/credits"
                }
              ]
            }
          }
        }
      }
    }
  }
}
