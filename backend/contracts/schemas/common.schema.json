{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JOVRA backend contracts: shared definitions",
  "description": "Shared $defs of the gateway and queue contracts (backend/contracts, S81). Generated by backend/contracts/tools/generate.py from tools/definitions.py.",
  "$defs": {
    "uuid": {
      "description": "A server-generated id: lowercase UUID version 4 (gen_random_uuid()).",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "localUuid": {
      "description": "A device-local UUID (ADR-0002), any version, either case; stored in local_*_id columns, never a cloud primary key.",
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "sha256": {
      "description": "SHA-256 as 64 lowercase hex digits.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dateTime": {
      "description": "RFC 3339 UTC timestamp with a Z suffix (same rule as spec/schemas/studio).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "env": {
      "description": "The gateway's environment. Demo has no gateway and no token (architecture §2).",
      "enum": [
        "test",
        "live"
      ]
    },
    "fps": {
      "description": "Exact frame rate num/den (spec/schemas/studio/studio-common.schema.json#/$defs/fps).",
      "type": "object",
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false,
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240000
        },
        "den": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1001
        }
      }
    },
    "credits": {
      "description": "Studio Credits, integer only (spec studio-common credits).",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "cameraSlot": {
      "enum": [
        "primary_baseline",
        "opposite_baseline",
        "near_deuce_corner",
        "near_ad_corner",
        "far_deuce_corner",
        "far_ad_corner"
      ]
    },
    "sourceState": {
      "enum": [
        "declared",
        "uploading",
        "uploaded_unverified",
        "verified",
        "rejected",
        "deleted"
      ]
    },
    "jobState": {
      "description": "public.job_state (architecture §4.2): the states of spec/studio/contracts/render-job-transitions.v1.json except the quote states draft and quoted.",
      "enum": [
        "consented",
        "upload_pending",
        "uploading",
        "queued",
        "normalizing",
        "syncing",
        "analyzing",
        "planning",
        "preview_rendering",
        "awaiting_review",
        "final_rendering",
        "verifying",
        "ready",
        "paused",
        "canceled",
        "failed_retryable",
        "failed_terminal",
        "quote_expired",
        "budget_exceeded",
        "deleted"
      ]
    },
    "jobStage": {
      "enum": [
        "verify_sources",
        "normalize",
        "sync",
        "analyze",
        "plan",
        "validate",
        "preview_render",
        "final_render",
        "remux_no_audio",
        "verify_output",
        "deliver",
        "cleanup"
      ]
    },
    "artifactKind": {
      "enum": [
        "analysis_proxy",
        "render_proxy",
        "pts_table",
        "frame_set",
        "contact_sheet",
        "preview",
        "film",
        "thumbnail",
        "captions",
        "chapters",
        "edit_manifest",
        "project_bundle",
        "clip_excerpt"
      ]
    },
    "artifactState": {
      "enum": [
        "writing",
        "verifying",
        "ready",
        "failed",
        "deleted"
      ]
    },
    "attemptState": {
      "enum": [
        "reserved",
        "dispatched",
        "running",
        "succeeded",
        "failed",
        "lease_expired",
        "canceled",
        "dead_lettered"
      ]
    },
    "deletionScope": {
      "enum": [
        "account",
        "project",
        "source",
        "artifact",
        "lesson",
        "lesson_clip"
      ]
    },
    "deletionState": {
      "enum": [
        "requested",
        "canceling_jobs",
        "deleting_objects",
        "deleting_rows",
        "revoking_apple",
        "done",
        "failed"
      ]
    },
    "uploadSessionState": {
      "enum": [
        "opening",
        "open",
        "completing",
        "completed",
        "aborted",
        "expired"
      ]
    },
    "displayLabel": {
      "description": "Short text a person typed (≤ 60 characters); shown as text, never logged.",
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "displayTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "machineCode": {
      "description": "A machine error or reason code; user copy is mapped in the app.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "deviceCode": {
      "description": "Six digits derived from the guest device key's thumbprint, shown on both phones (security-model §8.2).",
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "inviteCode": {
      "description": "Camera invite code (shown once, in the QR): 'jvi_' + 32 random bytes as unpadded base64url (security-model §8.1). A bearer secret: never logged, never stored except as its SHA-256.",
      "type": "string",
      "pattern": "^jvi_[A-Za-z0-9_-]{43}$"
    },
    "guestCapability": {
      "description": "Guest capability: 'jvg_' + 32 random bytes as unpadded base64url (security-model §8.1). A bearer secret: never logged, never stored except as its SHA-256.",
      "type": "string",
      "pattern": "^jvg_[A-Za-z0-9_-]{43}$"
    },
    "sessionCapability": {
      "description": "Upload session capability: 'jvs_' + 32 random bytes as unpadded base64url (security-model §8.1). A bearer secret: never logged, never stored except as its SHA-256.",
      "type": "string",
      "pattern": "^jvs_[A-Za-z0-9_-]{43}$"
    },
    "leaseToken": {
      "description": "Attempt lease token (minted at claim, never in a queue message): 'jvl_' + 32 random bytes as unpadded base64url (security-model §8.1). A bearer secret: never logged, never stored except as its SHA-256.",
      "type": "string",
      "pattern": "^jvl_[A-Za-z0-9_-]{43}$"
    },
    "shareToken": {
      "description": "Share link token: 'jvh_' + 32 random bytes as unpadded base64url (security-model §8.1). A bearer secret: never logged, never stored except as its SHA-256.",
      "type": "string",
      "pattern": "^jvh_[A-Za-z0-9_-]{43}$"
    },
    "grantCode": {
      "description": "Coach or viewer invitation code: 'jvc_' + 32 random bytes as unpadded base64url (security-model §8.1). A bearer secret: never logged, never stored except as its SHA-256.",
      "type": "string",
      "pattern": "^jvc_[A-Za-z0-9_-]{43}$"
    },
    "p256PublicJwk": {
      "description": "The guest device's P-256 public key as a JWK (RFC 7517/7518). Public members only: a private 'd' is invalid.",
      "type": "object",
      "required": [
        "kty",
        "crv",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "kty": {
          "const": "EC"
        },
        "crv": {
          "const": "P-256"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "nonce": {
      "description": "A server or client nonce, base64url (16 to 64 bytes).",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,86}$"
    },
    "p256Signature": {
      "description": "ECDSA P-256 signature as raw r||s (64 bytes, IEEE P1363), unpadded base64url (INFERRED encoding; WebCrypto's form).",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "inputRef": {
      "description": "An attempt input reference from render_attempts.input_refs; URL-safe, opaque.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "outputRef": {
      "description": "An attempt output reference from render_attempts.output_plan; URL-safe, opaque.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "etag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "probeSummary": {
      "description": "The device's own probe of its original, allowlisted to these six facts and stored as client_probe, never as the server probe (architecture §5.1, camera_sources.client_probe). Never free-form tags: QuickTime metadata can hold a location. Field names carry their units (INFERRED; the document says duration and rotation).",
      "type": "object",
      "required": [
        "codec",
        "width",
        "height",
        "fps",
        "durationUs",
        "rotationDegrees"
      ],
      "additionalProperties": false,
      "properties": {
        "codec": {
          "enum": [
            "h264",
            "hevc",
            "prores",
            "other"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 7680
        },
        "fps": {
          "$ref": "common.schema.json#/$defs/fps"
        },
        "durationUs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000000
        },
        "rotationDegrees": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        }
      }
    },
    "uploadSession": {
      "description": "An opened upload session (architecture §5.1, §6.2). partTarget describes where parts go, so a later move to direct-to-R2 parts is a server change only; until the B-12 spike it is the gateway's own part route.",
      "type": "object",
      "required": [
        "sessionId",
        "partSize",
        "partCount",
        "sessionCapability",
        "expiresAt",
        "hardExpiresAt",
        "partTarget"
      ],
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "partSize": {
          "description": "Fixed 32 MiB (upload_sessions.part_size).",
          "const": 33554432
        },
        "partCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "sessionCapability": {
          "$ref": "common.schema.json#/$defs/sessionCapability"
        },
        "expiresAt": {
          "description": "Idle expiry, renewed while parts arrive (≤ 24 h after the last part).",
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        "hardExpiresAt": {
          "description": "Absolute ceiling, opening + 48 h, never extended.",
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        "partTarget": {
          "type": "object",
          "required": [
            "method",
            "urlTemplate",
            "headers"
          ],
          "additionalProperties": false,
          "properties": {
            "method": {
              "const": "PUT"
            },
            "urlTemplate": {
              "description": "Absolute https URL with the literal placeholder {n} for the part number.",
              "type": "string",
              "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?/[^\\s]*\\{n\\}[^\\s]*$",
              "maxLength": 512
            },
            "headers": {
              "description": "Extra headers each part request must carry (names and fixed values only; never a secret other than the session capability placeholder).",
              "type": "object",
              "maxProperties": 8,
              "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "measurements": {
      "description": "Stage measurements reported by the render host (render_attempts.measurements; never shown to clients). Integers only.",
      "type": "object",
      "required": [
        "wallMs",
        "cpuMs",
        "bytesIn",
        "bytesOut"
      ],
      "additionalProperties": false,
      "properties": {
        "wallMs": {
          "type": "integer",
          "minimum": 0
        },
        "cpuMs": {
          "type": "integer",
          "minimum": 0
        },
        "bytesIn": {
          "type": "integer",
          "minimum": 0
        },
        "bytesOut": {
          "type": "integer",
          "minimum": 0
        },
        "plannerTokens": {
          "type": "object",
          "required": [
            "input",
            "cache",
            "output"
          ],
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0
            },
            "cache": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "errorBody": {
      "description": "Error envelope (architecture §5): {error: {code, message, retryable}, requestId}. The message is for logs and developers; the app maps code to copy. details is present only for dependents and secret_not_replayable (INFERRED shapes).",
      "type": "object",
      "required": [
        "error",
        "requestId"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "unauthorized",
                "demo_not_accepted",
                "reauth_required",
                "budget_exceeded",
                "not_found",
                "conflict",
                "already_claimed",
                "parts_mismatch",
                "requote_required",
                "dependents",
                "secret_not_replayable",
                "expired",
                "range_not_satisfiable",
                "invalid",
                "idempotency_key_reused",
                "rate_limited",
                "internal"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "const": "dependents"
                  }
                }
              },
              "then": {
                "required": [
                  "details"
                ],
                "properties": {
                  "details": {
                    "type": "object",
                    "required": [
                      "dependents"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "dependents": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "required": [
                            "artifactId",
                            "kind"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "artifactId": {
                              "$ref": "common.schema.json#/$defs/uuid"
                            },
                            "kind": {
                              "$ref": "common.schema.json#/$defs/artifactKind"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "const": "secret_not_replayable"
                  }
                }
              },
              "then": {
                "required": [
                  "details"
                ],
                "properties": {
                  "details": {
                    "type": "object",
                    "required": [
                      "resourceId"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "resourceId": {
                        "$ref": "common.schema.json#/$defs/uuid"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "enum": [
                      "dependents",
                      "secret_not_replayable"
                    ]
                  }
                }
              },
              "else": {
                "not": {
                  "required": [
                    "details"
                  ]
                }
              }
            }
          ]
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "clientRequestId": {
          "$ref": "common.schema.json#/$defs/uuid"
        }
      }
    },
    "requestIdHeader": {
      "description": "X-Request-Id: on a response the gateway's own UUID (equal to the body's requestId); on a request an optional client id, echoed as clientRequestId after format validation (INFERRED request header name).",
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "idempotencyKeyHeader": {
      "description": "Idempotency-Key: a UUIDv4 per logical request (architecture §5).",
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "bearerAuthorization": {
      "description": "Authorization: Bearer <Supabase access JWT>. The gateway verifies ES256, kid, iss, aud and exp; this schema checks only the scheme.",
      "type": "string",
      "pattern": "^Bearer [A-Za-z0-9._~+/-]+=*$",
      "maxLength": 4096
    },
    "guestAuthorization": {
      "description": "Authorization: JOVRA-Capability <jvg_ guest capability>.",
      "type": "string",
      "pattern": "^JOVRA-Capability jvg_[A-Za-z0-9_-]{43}$"
    },
    "sessionAuthorization": {
      "description": "Authorization: JOVRA-Capability <jvs_ upload session capability>.",
      "type": "string",
      "pattern": "^JOVRA-Capability jvs_[A-Za-z0-9_-]{43}$"
    },
    "hostAuthorization": {
      "description": "Authorization: JOVRA-Host <host credential> (security-model §8.4). The credential's format is the host adapter's; this schema checks the scheme.",
      "type": "string",
      "pattern": "^JOVRA-Host [A-Za-z0-9._~-]{16,256}$"
    },
    "leaseHeader": {
      "description": "JOVRA-Lease: the attempt's current jvl_ lease token.",
      "type": "string",
      "pattern": "^jvl_[A-Za-z0-9_-]{43}$"
    },
    "signatureTimestampHeader": {
      "description": "JOVRA-Timestamp: Unix seconds; ±5 minutes skew (INFERRED header name).",
      "type": "string",
      "pattern": "^[0-9]{10}$"
    },
    "signatureNonceHeader": {
      "description": "JOVRA-Nonce: single use within the 10-minute replay cache (INFERRED name).",
      "$ref": "common.schema.json#/$defs/nonce"
    },
    "guestSignatureHeader": {
      "description": "JOVRA-Signature: the guest device key's P-256 signature over (method, path, timestamp, nonce, body SHA-256) (security-model §8.2; INFERRED header name).",
      "$ref": "common.schema.json#/$defs/p256Signature"
    },
    "hostSignatureHeader": {
      "description": "JOVRA-Signature: HMAC-SHA256 over (method, path, timestamp, nonce, body SHA-256) with the per-environment host secret, unpadded base64url (security-model §8.4, external hosts only; INFERRED header name).",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "rangeHeader": {
      "description": "Range: a single byte range (RFC 9110).",
      "type": "string",
      "pattern": "^bytes=([0-9]+-[0-9]*|-[0-9]+)$"
    },
    "contentLengthHeader": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,12})$"
    },
    "contentRangeHeader": {
      "type": "string",
      "pattern": "^bytes [0-9]+-[0-9]+/[0-9]+$"
    },
    "jsonContentType": {
      "const": "application/json"
    },
    "jsonResponseHeaders": {
      "type": "object",
      "required": [
        "X-Request-Id",
        "Content-Type"
      ],
      "additionalProperties": false,
      "properties": {
        "X-Request-Id": {
          "$ref": "common.schema.json#/$defs/requestIdHeader"
        },
        "Content-Type": {
          "$ref": "common.schema.json#/$defs/jsonContentType"
        }
      }
    }
  }
}
