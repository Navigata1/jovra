{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/guest/sources request",
  "description": "guestSources.declare (jovra-gateway; caller: guest capability). A request descriptor: pathParams, query, headers and body. JSON body: #/$defs/body. Header names are canonical; compare them case-insensitively. A real request may carry other headers (User-Agent, Accept-Encoding) that the contract does not use.",
  "type": "object",
  "required": [
    "headers",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "headers": {
      "$ref": "#/$defs/headers"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "required": [
        "Authorization",
        "JOVRA-Timestamp",
        "JOVRA-Nonce",
        "JOVRA-Signature",
        "Idempotency-Key",
        "Content-Type"
      ],
      "additionalProperties": false,
      "properties": {
        "Authorization": {
          "$ref": "common.schema.json#/$defs/guestAuthorization"
        },
        "JOVRA-Timestamp": {
          "$ref": "common.schema.json#/$defs/signatureTimestampHeader"
        },
        "JOVRA-Nonce": {
          "$ref": "common.schema.json#/$defs/signatureNonceHeader"
        },
        "JOVRA-Signature": {
          "$ref": "common.schema.json#/$defs/guestSignatureHeader"
        },
        "Idempotency-Key": {
          "$ref": "common.schema.json#/$defs/idempotencyKeyHeader"
        },
        "Content-Type": {
          "$ref": "common.schema.json#/$defs/jsonContentType"
        },
        "X-Request-Id": {
          "$ref": "common.schema.json#/$defs/requestIdHeader"
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "localSourceId",
        "declaredBytes",
        "declaredSha256",
        "probeSummary",
        "participantAck"
      ],
      "additionalProperties": false,
      "properties": {
        "localSourceId": {
          "$ref": "common.schema.json#/$defs/localUuid"
        },
        "declaredBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "declaredSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "probeSummary": {
          "$ref": "common.schema.json#/$defs/probeSummary"
        },
        "participantAck": {
          "description": "The guest confirmed recording with the players' agreement.",
          "const": true
        }
      }
    }
  }
}
