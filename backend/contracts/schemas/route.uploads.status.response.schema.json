{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /v1/uploads/{sessionId} response",
  "description": "uploads.status: a response descriptor (status, headers, body). Success body: JSON. Every response carries X-Request-Id; a JSON body's requestId equals it.",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "success": {
      "description": "Success: 200 with the §5 envelope {data, requestId}.",
      "type": "object",
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": 200
        },
        "headers": {
          "$ref": "common.schema.json#/$defs/jsonResponseHeaders"
        },
        "body": {
          "type": "object",
          "required": [
            "data",
            "requestId"
          ],
          "additionalProperties": false,
          "properties": {
            "data": {
              "$ref": "#/$defs/data"
            },
            "requestId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "clientRequestId": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          }
        }
      }
    },
    "error": {
      "description": "An error: the §5 envelope with one of this route's codes at its HTTP status.",
      "type": "object",
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            401,
            404,
            410,
            500
          ]
        },
        "headers": {
          "$ref": "common.schema.json#/$defs/jsonResponseHeaders"
        },
        "body": {
          "$ref": "common.schema.json#/$defs/errorBody"
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": 401
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "unauthorized"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 404
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "not_found"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 410
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "expired"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 500
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "internal"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "data": {
      "type": "object",
      "required": [
        "state",
        "confirmedParts",
        "expiresAt"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/uploadSessionState"
        },
        "confirmedParts": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "required": [
              "n",
              "bytes",
              "etag"
            ],
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              },
              "etag": {
                "$ref": "common.schema.json#/$defs/etag"
              }
            }
          }
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/dateTime"
        }
      }
    }
  }
}
