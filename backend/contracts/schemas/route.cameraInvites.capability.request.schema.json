{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/camera-invites/redemptions/{redemptionId}/capability request",
  "description": "cameraInvites.capability (jovra-gateway; caller: guest). Signed challenge: the device key signs a server nonce. Where the guest obtains that nonce is not specified by §5.1 (README open question 1). A request descriptor: pathParams, query, headers and body. JSON body: #/$defs/body. Header names are canonical; compare them case-insensitively. A real request may carry other headers (User-Agent, Accept-Encoding) that the contract does not use.",
  "type": "object",
  "required": [
    "pathParams",
    "headers",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "pathParams": {
      "type": "object",
      "required": [
        "redemptionId"
      ],
      "additionalProperties": false,
      "properties": {
        "redemptionId": {
          "$ref": "common.schema.json#/$defs/uuid"
        }
      }
    },
    "headers": {
      "$ref": "#/$defs/headers"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "required": [
        "Idempotency-Key",
        "Content-Type"
      ],
      "additionalProperties": false,
      "properties": {
        "Idempotency-Key": {
          "$ref": "common.schema.json#/$defs/idempotencyKeyHeader"
        },
        "Content-Type": {
          "$ref": "common.schema.json#/$defs/jsonContentType"
        },
        "X-Request-Id": {
          "$ref": "common.schema.json#/$defs/requestIdHeader"
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "nonce",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "nonce": {
          "$ref": "common.schema.json#/$defs/nonce"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/p256Signature"
        }
      }
    }
  }
}
