{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /internal/v1/attempts/{attemptId}/claim request",
  "description": "internal.claim (jovra-internal; caller: render host). The lease token is minted now and returned once; only its hash is stored. A request descriptor: pathParams, query, headers and body. No body. Header names are canonical; compare them case-insensitively. A real request may carry other headers (User-Agent, Accept-Encoding) that the contract does not use.",
  "type": "object",
  "required": [
    "pathParams",
    "headers"
  ],
  "additionalProperties": false,
  "properties": {
    "pathParams": {
      "type": "object",
      "required": [
        "attemptId"
      ],
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "$ref": "common.schema.json#/$defs/uuid"
        }
      }
    },
    "headers": {
      "$ref": "#/$defs/headers"
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "required": [
        "Authorization",
        "Idempotency-Key"
      ],
      "additionalProperties": false,
      "properties": {
        "Authorization": {
          "$ref": "common.schema.json#/$defs/hostAuthorization"
        },
        "Idempotency-Key": {
          "$ref": "common.schema.json#/$defs/idempotencyKeyHeader"
        },
        "X-Request-Id": {
          "$ref": "common.schema.json#/$defs/requestIdHeader"
        },
        "JOVRA-Timestamp": {
          "$ref": "common.schema.json#/$defs/signatureTimestampHeader"
        },
        "JOVRA-Nonce": {
          "$ref": "common.schema.json#/$defs/signatureNonceHeader"
        },
        "JOVRA-Signature": {
          "$ref": "common.schema.json#/$defs/hostSignatureHeader"
        }
      },
      "dependentRequired": {
        "JOVRA-Signature": [
          "JOVRA-Timestamp",
          "JOVRA-Nonce"
        ]
      }
    }
  }
}
