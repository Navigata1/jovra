{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/grants request",
  "description": "grants.create (jovra-gateway; caller: owner). A request descriptor: pathParams, query, headers and body. JSON body: #/$defs/body. Header names are canonical; compare them case-insensitively. A real request may carry other headers (User-Agent, Accept-Encoding) that the contract does not use.",
  "type": "object",
  "required": [
    "headers",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "headers": {
      "$ref": "#/$defs/headers"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "required": [
        "Authorization",
        "Idempotency-Key",
        "Content-Type"
      ],
      "additionalProperties": false,
      "properties": {
        "Authorization": {
          "$ref": "common.schema.json#/$defs/bearerAuthorization"
        },
        "Idempotency-Key": {
          "$ref": "common.schema.json#/$defs/idempotencyKeyHeader"
        },
        "Content-Type": {
          "$ref": "common.schema.json#/$defs/jsonContentType"
        },
        "X-Request-Id": {
          "$ref": "common.schema.json#/$defs/requestIdHeader"
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "kind",
        "inviteeEmail",
        "expiresInSec"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "project_coach",
            "lesson_coach",
            "lesson_view",
            "film_view",
            "lesson_clip_view"
          ]
        },
        "inviteeEmail": {
          "description": "Required; stored only as an HMAC, never logged (architecture §5.1).",
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^@\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]+@[^@\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]+\\.[^@\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]+$"
        },
        "projectId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "lessonId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "artifactId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "lessonClipId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "expiresInSec": {
          "description": "End of access after redemption (INFERRED bound: up to 365 days).",
          "type": "integer",
          "minimum": 60,
          "maximum": 31536000
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "project_coach"
              }
            }
          },
          "then": {
            "required": [
              "projectId"
            ],
            "properties": {
              "lessonId": false,
              "artifactId": false,
              "lessonClipId": false
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "lesson_coach"
              }
            }
          },
          "then": {
            "required": [
              "lessonId"
            ],
            "properties": {
              "projectId": false,
              "artifactId": false,
              "lessonClipId": false
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "lesson_view"
              }
            }
          },
          "then": {
            "required": [
              "lessonId"
            ],
            "properties": {
              "projectId": false,
              "artifactId": false,
              "lessonClipId": false
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "film_view"
              }
            }
          },
          "then": {
            "required": [
              "artifactId"
            ],
            "properties": {
              "projectId": false,
              "lessonId": false,
              "lessonClipId": false
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "lesson_clip_view"
              }
            }
          },
          "then": {
            "required": [
              "lessonClipId"
            ],
            "properties": {
              "projectId": false,
              "lessonId": false,
              "artifactId": false
            }
          }
        }
      ]
    }
  }
}
