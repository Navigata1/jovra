{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/projects/{projectId}/quotes request",
  "description": "quotes.create (jovra-gateway; caller: owner). Every sourceId resolves through this project's current verified source manifest; inputs and output_spec_sha256 are computed server-side, never from the request's numbers. A request descriptor: pathParams, query, headers and body. JSON body: #/$defs/body. Header names are canonical; compare them case-insensitively. A real request may carry other headers (User-Agent, Accept-Encoding) that the contract does not use.",
  "type": "object",
  "required": [
    "pathParams",
    "headers",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "pathParams": {
      "type": "object",
      "required": [
        "projectId"
      ],
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "$ref": "common.schema.json#/$defs/uuid"
        }
      }
    },
    "headers": {
      "$ref": "#/$defs/headers"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "required": [
        "Authorization",
        "Idempotency-Key",
        "Content-Type"
      ],
      "additionalProperties": false,
      "properties": {
        "Authorization": {
          "$ref": "common.schema.json#/$defs/bearerAuthorization"
        },
        "Idempotency-Key": {
          "$ref": "common.schema.json#/$defs/idempotencyKeyHeader"
        },
        "Content-Type": {
          "$ref": "common.schema.json#/$defs/jsonContentType"
        },
        "X-Request-Id": {
          "$ref": "common.schema.json#/$defs/requestIdHeader"
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "storyPlanId",
        "plannerChoice",
        "outputSpec",
        "sourceIds",
        "retentionDays"
      ],
      "additionalProperties": false,
      "properties": {
        "storyPlanId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "storyPlanVersionId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "plannerChoice": {
          "enum": [
            "heuristic",
            "model"
          ]
        },
        "outputSpec": {
          "$ref": "#/$defs/outputSpec"
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        },
        "retentionDays": {
          "enum": [
            1,
            7,
            30
          ]
        }
      }
    },
    "outputSpec": {
      "description": "The film's output: the EDL output of spec/schemas/studio/edit-plan.schema.json (jovra.edit-plan/2) with totalFrames replaced by durationTargetSec (architecture §4.3 render_jobs.output_spec: fps rational, width, height, container and codecs, aspect, duration target). Imported by generate.py.",
      "type": "object",
      "required": [
        "fps",
        "width",
        "height",
        "aspect",
        "container",
        "videoCodec",
        "audioCodec",
        "audioSampleRate",
        "durationTargetSec"
      ],
      "additionalProperties": false,
      "properties": {
        "fps": {
          "$ref": "#/$defs/studio-common.fps"
        },
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3840,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3840,
          "multipleOf": 2
        },
        "aspect": {
          "$ref": "#/$defs/studio-common.aspect"
        },
        "container": {
          "const": "mp4"
        },
        "videoCodec": {
          "enum": [
            "h264",
            "hevc"
          ]
        },
        "audioCodec": {
          "const": "aac"
        },
        "audioSampleRate": {
          "const": 48000
        },
        "durationTargetSec": {
          "description": "Target length in whole seconds; the frame count is computed from the plan (INFERRED).",
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        }
      }
    },
    "studio-common.aspect": {
      "enum": [
        "16:9",
        "9:16",
        "1:1",
        "4:5"
      ]
    },
    "studio-common.fps": {
      "description": "Exact frame rate num/den, e.g. 30/1 or 30000/1001.",
      "type": "object",
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false,
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240000
        },
        "den": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1001
        }
      }
    }
  }
}
