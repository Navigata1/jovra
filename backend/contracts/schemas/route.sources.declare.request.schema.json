{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/projects/{projectId}/sources request",
  "description": "sources.declare (jovra-gateway; caller: owner). A request descriptor: pathParams, query, headers and body. JSON body: #/$defs/body. Header names are canonical; compare them case-insensitively. A real request may carry other headers (User-Agent, Accept-Encoding) that the contract does not use.",
  "type": "object",
  "required": [
    "pathParams",
    "headers",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "pathParams": {
      "type": "object",
      "required": [
        "projectId"
      ],
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "$ref": "common.schema.json#/$defs/uuid"
        }
      }
    },
    "headers": {
      "$ref": "#/$defs/headers"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "required": [
        "Authorization",
        "Idempotency-Key",
        "Content-Type"
      ],
      "additionalProperties": false,
      "properties": {
        "Authorization": {
          "$ref": "common.schema.json#/$defs/bearerAuthorization"
        },
        "Idempotency-Key": {
          "$ref": "common.schema.json#/$defs/idempotencyKeyHeader"
        },
        "Content-Type": {
          "$ref": "common.schema.json#/$defs/jsonContentType"
        },
        "X-Request-Id": {
          "$ref": "common.schema.json#/$defs/requestIdHeader"
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "slot",
        "localSourceId",
        "declaredBytes",
        "declaredSha256",
        "probeSummary"
      ],
      "additionalProperties": false,
      "properties": {
        "slot": {
          "$ref": "common.schema.json#/$defs/cameraSlot"
        },
        "localSourceId": {
          "$ref": "common.schema.json#/$defs/localUuid"
        },
        "declaredBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "declaredSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "probeSummary": {
          "$ref": "common.schema.json#/$defs/probeSummary"
        }
      }
    }
  }
}
