{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /internal/v1/attempts/{attemptId}/claim response",
  "description": "internal.claim: a response descriptor (status, headers, body). Success body: JSON. Every response carries X-Request-Id; a JSON body's requestId equals it.",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "success": {
      "description": "Success: 200 with the §5 envelope {data, requestId}.",
      "type": "object",
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": 200
        },
        "headers": {
          "$ref": "common.schema.json#/$defs/jsonResponseHeaders"
        },
        "body": {
          "type": "object",
          "required": [
            "data",
            "requestId"
          ],
          "additionalProperties": false,
          "properties": {
            "data": {
              "$ref": "#/$defs/data"
            },
            "requestId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "clientRequestId": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          }
        }
      }
    },
    "error": {
      "description": "An error: the §5 envelope with one of this route's codes at its HTTP status.",
      "type": "object",
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            401,
            404,
            409,
            422,
            500
          ]
        },
        "headers": {
          "$ref": "common.schema.json#/$defs/jsonResponseHeaders"
        },
        "body": {
          "$ref": "common.schema.json#/$defs/errorBody"
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": 401
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "unauthorized"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 404
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "not_found"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 409
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "already_claimed",
                        "secret_not_replayable"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 422
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "invalid",
                        "idempotency_key_reused"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": 500
            },
            "body": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "enum": [
                        "internal"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "data": {
      "type": "object",
      "required": [
        "leaseToken",
        "leasedUntil",
        "inputRefs",
        "outputPlan"
      ],
      "additionalProperties": false,
      "properties": {
        "leaseToken": {
          "$ref": "common.schema.json#/$defs/leaseToken"
        },
        "leasedUntil": {
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        "inputRefs": {
          "description": "render_attempts.input_refs, computed by reserve_stage (INFERRED item shape).",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "inputRef",
              "kind",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "inputRef": {
                "$ref": "common.schema.json#/$defs/inputRef"
              },
              "kind": {
                "enum": [
                  "source",
                  "artifact"
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              }
            }
          }
        },
        "outputPlan": {
          "description": "render_attempts.output_plan: refs, kinds and a byte cap per output.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "outputRef",
              "kind",
              "maxBytes"
            ],
            "additionalProperties": false,
            "properties": {
              "outputRef": {
                "$ref": "common.schema.json#/$defs/outputRef"
              },
              "kind": {
                "$ref": "common.schema.json#/$defs/artifactKind"
              },
              "maxBytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
