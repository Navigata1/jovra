{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/quotes/{quoteId}/accept request",
  "description": "quotes.accept (jovra-gateway; caller: owner). A re-quote after budget_exceeded returns the existing job and the topped-up reservation. A request descriptor: pathParams, query, headers and body. JSON body: #/$defs/body. Header names are canonical; compare them case-insensitively. A real request may carry other headers (User-Agent, Accept-Encoding) that the contract does not use.",
  "type": "object",
  "required": [
    "pathParams",
    "headers",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "pathParams": {
      "type": "object",
      "required": [
        "quoteId"
      ],
      "additionalProperties": false,
      "properties": {
        "quoteId": {
          "$ref": "common.schema.json#/$defs/uuid"
        }
      }
    },
    "headers": {
      "$ref": "#/$defs/headers"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "required": [
        "Authorization",
        "Idempotency-Key",
        "Content-Type"
      ],
      "additionalProperties": false,
      "properties": {
        "Authorization": {
          "$ref": "common.schema.json#/$defs/bearerAuthorization"
        },
        "Idempotency-Key": {
          "$ref": "common.schema.json#/$defs/idempotencyKeyHeader"
        },
        "Content-Type": {
          "$ref": "common.schema.json#/$defs/jsonContentType"
        },
        "X-Request-Id": {
          "$ref": "common.schema.json#/$defs/requestIdHeader"
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "inputsSha256",
        "consent",
        "acceptedCapCredits"
      ],
      "additionalProperties": false,
      "properties": {
        "inputsSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "consent": {
          "type": "object",
          "required": [
            "cloudProcessing",
            "modelProvider",
            "textClasses",
            "retentionDays",
            "consentTextVersion"
          ],
          "additionalProperties": false,
          "properties": {
            "cloudProcessing": {
              "const": true
            },
            "modelProvider": {
              "type": "boolean"
            },
            "textClasses": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "ownerNotes",
                  "ownerLessonNotes",
                  "coachNotes"
                ]
              }
            },
            "retentionDays": {
              "enum": [
                1,
                7,
                30
              ]
            },
            "consentTextVersion": {
              "type": "string",
              "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "acceptedCapCredits": {
          "$ref": "common.schema.json#/$defs/credits"
        }
      }
    }
  }
}
