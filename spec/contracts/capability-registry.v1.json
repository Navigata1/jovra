    {
      "id": "audio.hitDetection",
      "title": "Racket-ball hit detection (audio)",
      "status": "disabled",
      "inV1": true,
      "method": "Spectral-flux onsets on the audio track with travel-time correction (vDSP / Accelerate).",
      "version": "1.0.0",
      "uiLabel": "Estimated",
      "outputsNeedReview": true,
      "requires": {"calibration": false, "microphone": true, "video": true},
      "gate": {
        "promotesTo": "estimated",
        "metrics": [
          {"name": "own-court hit precision", "comparator": ">=", "threshold": "0.95"},
          {"name": "own-court hit recall", "comparator": ">=", "threshold": "0.90"},
          {"name": "onset MAE", "comparator": "<=", "threshold": "10", "unit": "ms"}
        ],
        "minimumData": "Synthetic sample video benchmark plus >= 10 real sessions at >= 3 venues"
      },
      "lastBenchmark": null,
      "notes": "D10: suggestions always start as Needs review. Unavailable when the microphone is off (D5)."
    },
    {
      "id": "rally.segmentation",
      "title": "Rally segmentation",
      "status": "disabled",
      "inV1": true,
      "method": "Rallies = hits with gaps < ~3 s; point gaps > ~5 s; motion corroboration.",
      "version": "1.0.0",
      "uiLabel": "Estimated",
      "outputsNeedReview": true,
      "requires": {"calibration": false, "microphone": true, "video": true, "capabilities": ["audio.hitDetection"]},
      "gate": {
        "promotesTo": "estimated",
