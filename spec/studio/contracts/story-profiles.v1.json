      "editing": {
        "cutPolicy": "stay on selected wide angle during play; replays and alternate views after point end",
        "pace": "faithful to play",
        "overlays": [
          "reviewed score",
          "server indicator when recorded",
          "set context"
        ],
        "effects": "quiet transitions and restrained lower thirds"
      },
      "mustNot": [
        "jump to an unsynchronized view",
        "hide missing recording intervals",
        "invent commentary or score",
        "present a flat movie as interactive multi-angle replay"
      ],
      "fallback": "A complete one-angle match with chapter markers.",
