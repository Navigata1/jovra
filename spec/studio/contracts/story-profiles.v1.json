    {
      "id": "rally-pulse",
      "revision": 1,
      "name": "Rally Pulse",
      "intent": "Create an energetic highlight film without losing the point’s meaning.",
      "recommendedDurationSeconds": [
        30,
        180
      ],
      "beats": [
        "Strong real rally opening",
        "Short build",
        "Key exchange",
        "Point payoff",
        "Quiet closing moment"
      ],
      "editing": {
        "cutPolicy": "keep the selected rally sequence intact; energy cuts between points",
        "pace": "quick between rallies, clear during live action",
        "overlays": [
          "point context",
          "small reviewed fact"
        ],
        "effects": "optional beat-aligned cuts, title accents and brief transitions; shake off by default; clean alternate version",
        "music": "user-selected licensed track or court sound"
      },
      "mustNot": [
        "flash or shake over contact frames",
        "misrepresent missed shots as winners",
        "use an unlicensed popular song"
      ],
      "fallback": "Court-sound highlights with static titles.",
