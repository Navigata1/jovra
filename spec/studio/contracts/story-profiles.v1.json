    {
      "id": "coach-cut",
      "revision": 1,
      "name": "Coach’s Cut",
      "intent": "Turn a match or lesson into evidence-linked instruction.",
      "recommendedDurationSeconds": [
        180,
        600
      ],
      "beats": [
        "Goal and context",
        "Observed pattern",
        "Two or three source-linked examples",
        "Reviewed cue or user note",
        "Practice drill and next checkpoint"
      ],
      "editing": {
        "cutPolicy": "at point boundaries; within-rally cuts only for a reviewed demonstration",
        "pace": "deliberate",
        "replay": "original speed first; optional labelled slow motion; no synthetic intermediate frames by default",
        "overlays": [
          "point-event score",
          "source time",
          "reviewed cue",
          "2D annotation"
        ],
        "effects": "arrows and freeze frames outside the original-speed keeper"
      },
      "mustNot": [
        "diagnose injury",
        "claim unvalidated biomechanics",
        "replace a coach observation with a fabricated measurement"
      ],
      "fallback": "Use user notes and manually chosen clips when automatic observations are unavailable.",
      "grammar": {
        "durationSeconds": {
          "min": 180,
          "max": 600
        },
        "chronology": "free",
        "ops": [
          "live",
          "replay",
          "freeze",
          "title-card"
        ],
        "replaySpeedDens": [
          2,
          4
        ],
        "transitions": [
          "dissolve"
        ],
        "maxTransitionMs": 400,
        "freezeMs": {
          "min": 500,
          "max": 3000
        },
        "cardMs": {
          "min": 1000,
          "max": 6000
        },
        "replayMaxMs": 8000,
        "reframe": "if-box-fits",
        "gradePresets": [
          "none"
        ],
