{
  "schemaVersion": "jovra.studio-fixture.invalid-cases/1",
  "base": "records/quote.sample-illustrative.json",
  "cases": [
    {
      "id": "illustrative-accepted",
      "why": "The screen-37 sample quote can never be accepted",
      "patch": [
        {
          "op": "replace",
          "path": "/status",
          "value": "accepted"
        },
        {
          "op": "replace",
          "path": "/acceptedAt",
          "value": "2026-10-07T22:50:00Z"
        },
        {
          "op": "replace",
          "path": "/consent",
          "value": {
            "consentRecordId": "consent-x",
            "uploadSelectedSources": true,
            "modelProvider": true,
            "textClasses": [
              "ownerNotes"
            ],
            "retentionDays": 7,
            "consentTextVersion": "studio-cloud-consent@1.0.0",
            "at": "2026-10-07T22:49:00Z"
          }
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "illustrativeQuote"
      }
    },
    {
      "id": "long-lived-quote",
      "why": "Quotes expire within 30 minutes",
      "patch": [
        {
          "op": "replace",
          "path": "/expiresAt",
          "value": "2026-10-08T00:45:00Z"
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "quoteLifetime"
      }
    },
    {
      "id": "client-set-cap",
      "why": "The cap follows the class minimum and estimate",
      "patch": [
        {
          "op": "replace",
          "path": "/capCredits",
          "value": 3
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "quoteCapMismatch"
      }
    }
  ]
}
