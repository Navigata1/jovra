      "expect": {
        "layer": "reference",
        "code": "kindMismatch"
      }
    },
    {
      "id": "cue-overlay-laundered",
      "why": "Re-pointing the cue overlay at the estimated cue while keeping 'reviewed'",
      "patch": [
        {
          "op": "replace",
          "path": "/segments/2/overlayRefs/1/refId",
          "value": "cue-04"
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "provenanceMismatch"
      }
    },
    {
      "id": "card-text-unresolved",
      "why": "Card text comes only from stored notes",
      "patch": [
        {
          "op": "replace",
          "path": "/segments/0/textRefs",
          "value": [
            "40-15"
          ]
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "untrustedReference"
      }
    },
    {
      "id": "card-text-not-a-note",
      "why": "A score record is not card text",
      "patch": [
        {
          "op": "replace",
          "path": "/segments/0/textRefs",
          "value": [
            "p-041"
          ]
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "kindMismatch"
      }
    },
    {
      "id": "narration-script-unresolved",
      "why": "A narration script is grounded in stored notes",
      "patch": [
        {
          "op": "replace",
          "path": "/audio/narration/scriptNoteIds",
          "value": [
