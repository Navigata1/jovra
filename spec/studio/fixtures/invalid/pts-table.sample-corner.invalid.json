{
  "schemaVersion": "jovra.studio-fixture.invalid-cases/1",
  "base": "records/pts-table.sample-corner.json",
  "cases": [
    {
      "id": "rotation-not-swapped",
      "why": "A quarter-turn proxy keeps the display orientation (1080x1920), not the coded one",
      "patch": [
        {
          "op": "replace",
          "path": "/proxy/width",
          "value": 1920
        },
        {
          "op": "replace",
          "path": "/proxy/height",
          "value": 1080
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "proxyRotation"
      }
    },
    {
      "id": "rotation-not-applied",
      "why": "The rotation is baked into the pixels exactly once",
      "patch": [
        {
          "op": "replace",
          "path": "/proxy/rotationAppliedDegrees",
          "value": 0
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "proxyRotation"
      }
    },
    {
      "id": "rotation-applied-twice",
      "why": "Display rotation left in the container would be applied again by players",
      "patch": [
        {
          "op": "replace",
          "path": "/proxy/displayRotationDegrees",
          "value": 90
        }
      ],
      "expect": {
        "layer": "schema"
      }
    },
    {
      "id": "hdr-tone-map-omitted",
      "why": "An HDR original declares its tone-map method",
      "patch": [
        {
          "op": "replace",
          "path": "/proxy/toneMap",
          "value": null
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "toneMapUndeclared"
      }
    },
    {
      "id": "tone-map-unknown-method",
      "why": "Tone-map methods come from the closed list",
      "patch": [
        {
          "op": "replace",
          "path": "/proxy/toneMap/method",
          "value": "auto"
        }
      ],
      "expect": {
        "layer": "schema"
      }
    },
    {
      "id": "sdr-tone-mapped",
      "why": "An SDR original is not tone-mapped",
      "patch": [
        {
          "op": "replace",
          "path": "/original/hdr",
          "value": false
        },
        {
          "op": "replace",
          "path": "/original/transfer",
          "value": "bt709"
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "toneMapOnSdr"
      }
    },
    {
      "id": "proxy-left-hdr",
      "why": "A render proxy is 8-bit BT.709",
      "patch": [
        {
          "op": "replace",
          "path": "/proxy/transfer",
          "value": "hlg"
        }
      ],
      "expect": {
        "layer": "schema"
      }
    },
    {
      "id": "track-timescale-600",
      "why": "The track timescale is lcm(fps num, 1000)",
      "patch": [
        {
          "op": "replace",
          "path": "/proxy/timescale",
          "value": 600
        },
        {
          "op": "replace",
          "path": "/proxy/frameDurationTicks",
          "value": 20
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "badTimescale"
      }
    },
    {
      "id": "nonzero-start",
      "why": "Render proxies start at zero",
      "patch": [
        {
          "op": "replace",
          "path": "/proxy/startPts",
          "value": 1001
        }
      ],
      "expect": {
        "layer": "schema"
      }
    },
    {
      "id": "half-even-selection-forged",
      "why": "Runs computed with half-even ties select frame 30 for slot 30",
      "patch": [
        {
          "op": "replace",
          "path": "/runs",
          "value": [
            {
              "proxyFrame": 0,
              "count": 60,
              "originalFrame": 0,
              "originalStep": 1,
              "originalPts": 0
            }
          ]
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "ptsTableMismatch"
      }
    },
    {
      "id": "frame-count-off-by-one",
      "why": "The proxy frame count follows the half-up rule",
      "patch": [
        {
          "op": "replace",
          "path": "/proxy/frameCount",
          "value": 61
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "ptsTableMismatch"
      }
