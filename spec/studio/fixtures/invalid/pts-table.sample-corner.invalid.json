    {
      "id": "upconversion-unlabelled",
      "why": "A 60 fps proxy of a 30 fps source is labelled upconverted",
      "patch": [
        {
          "op": "replace",
          "path": "/proxy/fps",
          "value": {
            "num": 60,
            "den": 1
          }
        },
        {
          "op": "replace",
          "path": "/proxy/frameDurationTicks",
          "value": 50
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "unlabelledUpconversion"
      }
    },
    {
      "id": "short-edge-not-even",
      "why": "The proxy keeps the display aspect with an even short edge",
      "patch": [
        {
          "op": "replace",
          "path": "/proxy/width",
          "value": 1078
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "badDimensions"
