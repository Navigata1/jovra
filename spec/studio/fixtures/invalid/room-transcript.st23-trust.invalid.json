{
  "schemaVersion": "jovra.studio-fixture.invalid-cases/1",
  "base": "records/room-transcript.st23-trust.json",
  "cases": [
    {
      "id": "reused-code",
      "why": "A used code is refused for every later phone",
      "patch": [
        {
          "op": "replace",
          "path": "/steps/12/verdict",
          "value": {
            "accepted": true
          }
        }
      ],
      "expect": {
        "layer": "reference",
        "code": "inviteUsed"
      }
    },
    {
      "id": "typed-code-without-binding",
