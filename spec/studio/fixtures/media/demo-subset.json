{
  "schemaVersion": "jovra.studio-media-demo-subset/1",
  "sample": true,
  "installTo": "ios/Jovra/Resources/StudioSampleMedia",
  "budgetBytes": 25000000,
  "installer": "scripts/media/studio/install_demo.py",
  "files": [
    {
      "manifest": "media/angles/angle-baseline.json",
      "fileName": "studio-angle-baseline.mp4",
      "role": "angle",
      "angle": "Baseline"
    },
    {
      "manifest": "media/angles/angle-far-baseline.json",
      "fileName": "studio-angle-far-baseline.mp4",
      "role": "angle",
      "angle": "Far baseline"
    },
    {
      "manifest": "media/angles/angle-near-left.json",
      "fileName": "studio-angle-near-left.mp4",
      "role": "angle",
      "angle": "Near left"
    },
    {
      "manifest": "media/angles/angle-near-right.json",
      "fileName": "studio-angle-near-right.mp4",
      "role": "angle",
      "angle": "Near right"
    },
    {
      "manifest": "media/angles/angle-far-left.json",
      "fileName": "studio-angle-far-left.mp4",
      "role": "angle",
      "angle": "Far left"
    },
    {
      "manifest": "media/angles/angle-far-right.json",
      "fileName": "studio-angle-far-right.mp4",
      "role": "angle",
      "angle": "Far right"
    }
  ]
}
