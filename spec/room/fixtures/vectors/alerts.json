{
  "schemaVersion": "jovra.room-fixture.vectors/1",
  "kind": "alerts",
  "status": "AlertPolicy on the phone (watch spec 'Haptics and alerts'; ADR-0026 §8 as amended); times are phone monotonic ms",
  "cases": [
    {
      "id": "raise-after-3s",
      "why": "A recording camera Unknown for 3 s raises one deferred alert; the next point delivers its haptic",
      "acceptanceRows": [
        6,
        19
      ],
      "steps": [
        {
          "t": 0,
          "op": "status",
          "deviceId": "c3",
          "freshness": "Fresh",
          "captureState": "Recording"
        },
        {
          "t": 1000,
          "op": "status",
          "deviceId": "c3",
          "freshness": "Unknown",
          "captureState": "Recording"
        },
        {
          "t": 3999,
          "op": "tick"
        },
        {
          "t": 4000,
          "op": "tick"
        },
        {
          "t": 10000,
          "op": "point"
        }
      ],
      "expect": {
        "events": [
          {
            "t": 4000,
            "event": "raise",
            "alertId": "alert-1",
            "kind": "cameraUnknown",
            "deviceId": "c3",
            "severity": "deferred"
          },
          {
            "t": 10000,
            "event": "haptic",
            "alertIds": [
              "alert-1"
            ],
            "pattern": "deferred"
          }
        ],
        "commandsIssued": []
      }
    },
    {
