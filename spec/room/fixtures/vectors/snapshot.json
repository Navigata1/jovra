{
  "schemaVersion": "jovra.room-fixture.vectors/1",
  "kind": "snapshot",
  "status": "Envelope patches apply to records/room-snapshot.json; every patched envelope is schema-valid. Nothing unauthenticated changes receiver state",
  "cases": [
    {
      "id": "replay-and-order",
      "why": "Strictly increasing snapshotSeq; replays and reordering are rejected",
      "acceptanceRows": [
        5
      ],
      "initial": {
        "sessionId": "sample-jon-alex",
        "hostEpoch": 3,
        "hostKey": "bbfbe0c66faa5f6105cdced46762eeef30997ef9279f11ffe7341c2738f13065",
        "hostDeviceId": "c1",
        "members": [
          "c1",
          "c2",
          "c3",
          "c4",
          "c5",
          "c6"
        ],
        "rosterRevision": 1
      },
      "steps": [
        {
          "op": "accept",
          "envelopePatch": [
            {
              "op": "replace",
              "path": "/snapshotSeq",
              "value": 12
            }
          ],
          "expect": "accepted"
        },
        {
          "op": "accept",
          "envelopePatch": [
            {
              "op": "replace",
              "path": "/snapshotSeq",
              "value": 12
            }
          ],
          "expect": "replayOrOutOfOrder"
        },
        {
          "op": "accept",
          "envelopePatch": [
            {
              "op": "replace",
              "path": "/snapshotSeq",
              "value": 11
            }
          ],
          "expect": "replayOrOutOfOrder"
        },
        {
          "op": "accept",
          "envelopePatch": [
            {
              "op": "replace",
              "path": "/snapshotSeq",
              "value": 13
            }
          ],
          "expect": "accepted"
        },
        {
          "op": "assert",
          "expect": {
            "lastSeq": 13,
            "hostEpoch": 3
          }
        }
      ]
    },
