{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JOVRA Studio edit decision list (jovra.edit-plan/2)",
  "description": "Renderer-facing edit list compiled by deterministic code from a StoryBrief. Superset of tools/studio-plan's jovra.edit-plan/1: adds labelled replays at bounded speeds, freezes, title cards, B-roll, overlay references bound to the event revision, allowlisted transitions, an audio bed with one primary court source plus optional ducked, consented narration and rights-bound music, output aspect with letterbox or reviewed reframe windows, chapters and a clean-alternate flag. Times are integer frames on exact rational clocks; session times are integer microseconds. There is no command, path, URL, secret, approval or price field: authorization and spend live in the RenderJob and UsageReservation. Semantic rules (coverage, sync, clean-frame, handles, stale revisions) are in spec/reference/studio/edl.py.",
  "type": "object",
  "required": ["schemaVersion", "projectId", "planId", "planRevision", "sample", "cleanAlternate", "bindings", "output", "grade", "sources", "segments", "chapters", "audio"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "jovra.edit-plan/2"},
    "projectId": {"$ref": "studio-common.schema.json#/$defs/id"},
    "planId": {"$ref": "studio-common.schema.json#/$defs/id"},
    "planRevision": {"$ref": "studio-common.schema.json#/$defs/revision"},
    "sample": {"$ref": "studio-common.schema.json#/$defs/sample"},
    "cleanAlternate": {"description": "True when this plan is the clean (Reduce Motion) alternate: same cuts, no dissolves, dips or moving reframes.", "type": "boolean"},
    "bindings": {
      "description": "Revisions whose change makes this plan, and every film built from it, stale.",
      "type": "object",
      "required": ["sourceManifestRevision", "syncRevision", "eventRevision", "profileId", "profileRevision", "keeperCatalogRevision", "brollCatalogRevision"],
      "additionalProperties": false,
      "properties": {
        "sourceManifestRevision": {"$ref": "studio-common.schema.json#/$defs/revision"},
        "syncRevision": {"$ref": "studio-common.schema.json#/$defs/revision"},
        "eventRevision": {"$ref": "studio-common.schema.json#/$defs/revision"},
        "profileId": {"$ref": "studio-common.schema.json#/$defs/profileId"},
        "profileRevision": {"$ref": "studio-common.schema.json#/$defs/revision"},
        "keeperCatalogRevision": {"$ref": "studio-common.schema.json#/$defs/revision"},
        "brollCatalogRevision": {"$ref": "studio-common.schema.json#/$defs/revision"}
      }
    },
    "output": {
      "type": "object",
      "required": ["fps", "width", "height", "aspect", "totalFrames", "container", "videoCodec", "audioCodec", "audioSampleRate"],
      "additionalProperties": false,
      "properties": {
        "fps": {"$ref": "studio-common.schema.json#/$defs/fps"},
        "width": {"type": "integer", "minimum": 2, "maximum": 3840, "multipleOf": 2},
        "height": {"type": "integer", "minimum": 2, "maximum": 3840, "multipleOf": 2},
        "aspect": {"$ref": "studio-common.schema.json#/$defs/aspect"},
        "totalFrames": {"$ref": "studio-common.schema.json#/$defs/posInt"},
        "container": {"const": "mp4"},
        "videoCodec": {"enum": ["h264", "hevc"]},
        "audioCodec": {"const": "aac"},
        "audioSampleRate": {"const": 48000}
      }
    },
    "grade": {
      "type": "object",
      "required": ["presetId"],
      "additionalProperties": false,
      "properties": {"presetId": {"$ref": "studio-common.schema.json#/$defs/gradePreset"}}
    },
    "sources": {"type": "array", "minItems": 1, "maxItems": 18, "items": {"$ref": "#/$defs/source"}},
    "segments": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/segment"}},
    "chapters": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/chapter"}},
    "audio": {"$ref": "#/$defs/audio"}
  },
  "$defs": {
    "source": {
      "description": "Planning snapshot of a trusted source: the original's hash, its render proxy clock, audio availability and the reviewed coverage copied from the SyncMap. Validators re-check it against the trusted manifest; a client or model snapshot is never authority.",
      "type": "object",
      "required": ["id", "role", "sha256", "proxy", "hasAudio", "coverage"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "studio-common.schema.json#/$defs/id"},
        "role": {"enum": ["match", "broll"]},
        "sha256": {"$ref": "studio-common.schema.json#/$defs/sha256"},
        "proxy": {
          "type": "object",
          "required": ["fps", "width", "height", "frameCount", "ptsTableSha256"],
          "additionalProperties": false,
          "properties": {
            "fps": {"$ref": "studio-common.schema.json#/$defs/fps"},
            "width": {"type": "integer", "minimum": 2, "maximum": 7680},
            "height": {"type": "integer", "minimum": 2, "maximum": 7680},
            "frameCount": {"$ref": "studio-common.schema.json#/$defs/posInt"},
            "ptsTableSha256": {"$ref": "studio-common.schema.json#/$defs/sha256"}
          }
        },
        "hasAudio": {"type": "boolean"},
        "coverage": {
          "description": "Covered proxy-frame intervals. Match sources carry the session mapping session(f) = sessionStartUs + (f - inFrame) * frameDuration * rate; B-roll is off the session clock (nulls). Gaps between intervals are never crossed.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["inFrame", "outFrame", "sessionStartUs", "rate"],
            "additionalProperties": false,
            "properties": {
              "inFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
              "outFrame": {"$ref": "studio-common.schema.json#/$defs/posInt"},
              "sessionStartUs": {"type": ["integer", "null"], "minimum": 0},
              "rate": {"oneOf": [{"type": "null"}, {"$ref": "studio-common.schema.json#/$defs/rate"}]}
            }
          }
        }
      }
    },
    "transition": {
      "description": "Incoming transition at this segment's first frame, from the allowlist. A dissolve or dip of n frames is centred on the cut and needs n/2 source handle frames on each side inside the same coverage interval.",
      "type": "object",
      "required": ["type", "frames"],
      "additionalProperties": false,
      "properties": {
        "type": {"$ref": "studio-common.schema.json#/$defs/transitionType"},
        "frames": {"type": "integer", "minimum": 0, "maximum": 30}
      }
    },
    "overlayRef": {
      "description": "A reference to a stored record. The renderer derives the displayed value (score, numerator/denominator, cue text) from the bound event revision; the plan never carries digits or quotes.",
      "type": "object",
      "required": ["kind", "refId", "eventRevision", "provenance"],
      "additionalProperties": false,
      "properties": {
        "kind": {"$ref": "studio-common.schema.json#/$defs/overlayKind"},
        "refId": {"$ref": "studio-common.schema.json#/$defs/id"},
        "eventRevision": {"$ref": "studio-common.schema.json#/$defs/revision"},
        "provenance": {"$ref": "studio-common.schema.json#/$defs/provenanceStatus"}
      }
    },
    "overlayRefs": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/overlayRef"}},
    "framing": {
      "oneOf": [
        {"type": "object", "required": ["mode"], "additionalProperties": false, "properties": {"mode": {"enum": ["fill", "letterbox"]}}},
        {
          "type": "object",
          "required": ["mode", "basis", "windows"],
          "additionalProperties": false,
          "properties": {
            "mode": {"const": "reframe"},
            "basis": {"const": "reviewed-action-box"},
            "windows": {
              "description": "Crop keyframes in 1/10000 of the source frame, linear between keyframes; atFrame is relative to the segment start.",
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "required": ["atFrame", "x", "y", "w", "h"],
                "additionalProperties": false,
                "properties": {
                  "atFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
                  "x": {"type": "integer", "minimum": 0, "maximum": 10000},
                  "y": {"type": "integer", "minimum": 0, "maximum": 10000},
                  "w": {"type": "integer", "minimum": 1, "maximum": 10000},
                  "h": {"type": "integer", "minimum": 1, "maximum": 10000}
                }
              }
            }
          }
        }
      ]
    },
    "frameWindow": {"$ref": "studio-common.schema.json#/$defs/frameWindow"},
    "segment": {
      "oneOf": [
        {"$ref": "#/$defs/liveSegment"},
        {"$ref": "#/$defs/brollSegment"},
        {"$ref": "#/$defs/replaySegment"},
        {"$ref": "#/$defs/freezeSegment"},
        {"$ref": "#/$defs/cardSegment"}
      ]
    },
    "liveSegment": {
      "description": "A source window at original speed, bound to its session start time and keeper. protectedFrames are contact windows no transition may touch.",
      "type": "object",
      "required": ["id", "op", "outputInFrame", "outputOutFrame", "transitionIn", "sourceId", "sourceInFrame", "sourceOutFrame", "speed", "sessionInUs", "keeperId", "protectedFrames", "overlayRefs", "framing"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "studio-common.schema.json#/$defs/id"},
        "op": {"const": "live"},
        "outputInFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "outputOutFrame": {"$ref": "studio-common.schema.json#/$defs/posInt"},
        "transitionIn": {"$ref": "#/$defs/transition"},
        "sourceId": {"$ref": "studio-common.schema.json#/$defs/id"},
        "sourceInFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "sourceOutFrame": {"$ref": "studio-common.schema.json#/$defs/posInt"},
        "speed": {"type": "object", "required": ["num", "den"], "additionalProperties": false, "properties": {"num": {"const": 1}, "den": {"const": 1}}},
        "sessionInUs": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "keeperId": {"oneOf": [{"type": "null"}, {"$ref": "studio-common.schema.json#/$defs/id"}]},
        "protectedFrames": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/frameWindow"}},
        "overlayRefs": {"$ref": "#/$defs/overlayRefs"},
        "framing": {"$ref": "#/$defs/framing"}
      }
    },
    "brollSegment": {
      "type": "object",
      "required": ["id", "op", "outputInFrame", "outputOutFrame", "transitionIn", "sourceId", "sourceInFrame", "sourceOutFrame", "speed", "brollId", "overlayRefs", "framing"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "studio-common.schema.json#/$defs/id"},
        "op": {"const": "broll"},
        "outputInFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "outputOutFrame": {"$ref": "studio-common.schema.json#/$defs/posInt"},
        "transitionIn": {"$ref": "#/$defs/transition"},
        "sourceId": {"$ref": "studio-common.schema.json#/$defs/id"},
        "sourceInFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "sourceOutFrame": {"$ref": "studio-common.schema.json#/$defs/posInt"},
        "speed": {"type": "object", "required": ["num", "den"], "additionalProperties": false, "properties": {"num": {"const": 1}, "den": {"const": 1}}},
        "brollId": {"$ref": "studio-common.schema.json#/$defs/id"},
        "overlayRefs": {"$ref": "#/$defs/overlayRefs"},
        "framing": {"$ref": "#/$defs/framing"}
      }
    },
    "replaySegment": {
      "description": "A labelled re-showing of session time an earlier live segment already showed, at 1, 1/2, 1/4 or 1/8 speed, only where source fps x speed >= output fps (no interpolated frames).",
      "type": "object",
      "required": ["id", "op", "outputInFrame", "outputOutFrame", "transitionIn", "sourceId", "sourceInFrame", "sourceOutFrame", "speed", "replayOf", "labelTemplateId", "overlayRefs", "framing"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "studio-common.schema.json#/$defs/id"},
        "op": {"const": "replay"},
        "outputInFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "outputOutFrame": {"$ref": "studio-common.schema.json#/$defs/posInt"},
        "transitionIn": {"$ref": "#/$defs/transition"},
        "sourceId": {"$ref": "studio-common.schema.json#/$defs/id"},
        "sourceInFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "sourceOutFrame": {"$ref": "studio-common.schema.json#/$defs/posInt"},
        "speed": {"$ref": "studio-common.schema.json#/$defs/speed"},
        "replayOf": {"$ref": "studio-common.schema.json#/$defs/id"},
        "labelTemplateId": {"const": "label.replay"},
        "overlayRefs": {"$ref": "#/$defs/overlayRefs"},
        "framing": {"$ref": "#/$defs/framing"}
      }
    },
    "freezeSegment": {
      "type": "object",
      "required": ["id", "op", "outputInFrame", "outputOutFrame", "transitionIn", "sourceId", "sourceFrame", "labelTemplateId", "overlayRefs", "framing"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "studio-common.schema.json#/$defs/id"},
        "op": {"const": "freeze"},
        "outputInFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "outputOutFrame": {"$ref": "studio-common.schema.json#/$defs/posInt"},
        "transitionIn": {"$ref": "#/$defs/transition"},
        "sourceId": {"$ref": "studio-common.schema.json#/$defs/id"},
        "sourceFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "labelTemplateId": {"const": "label.paused"},
        "overlayRefs": {"$ref": "#/$defs/overlayRefs"},
        "framing": {"$ref": "#/$defs/framing"}
      }
    },
    "cardSegment": {
      "description": "A title, goal, chapter, drill or recording-gap card. Its text comes only from stored user records (textRefs) and catalog template slots filled by code.",
      "type": "object",
      "required": ["id", "op", "outputInFrame", "outputOutFrame", "transitionIn", "templateId", "textRefs", "overlayRefs"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "studio-common.schema.json#/$defs/id"},
        "op": {"const": "title-card"},
        "outputInFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "outputOutFrame": {"$ref": "studio-common.schema.json#/$defs/posInt"},
        "transitionIn": {"$ref": "#/$defs/transition"},
        "templateId": {"$ref": "studio-common.schema.json#/$defs/templateId"},
        "textRefs": {"type": "array", "maxItems": 4, "items": {"$ref": "studio-common.schema.json#/$defs/id"}},
        "overlayRefs": {"$ref": "#/$defs/overlayRefs"}
      }
    },
    "chapter": {
      "type": "object",
      "required": ["id", "outputInFrame", "templateId"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "studio-common.schema.json#/$defs/id"},
        "outputInFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "templateId": {"$ref": "studio-common.schema.json#/$defs/templateId"}
      }
    },
    "outputWindow": {
      "type": "object",
      "required": ["outputInFrame", "outputOutFrame"],
      "additionalProperties": false,
      "properties": {
        "outputInFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
        "outputOutFrame": {"$ref": "studio-common.schema.json#/$defs/posInt"}
      }
    },
    "audio": {
      "description": "Exactly one bed route per output frame. primary-bed: the designated court source, in sync with live picture, and only under live segments. hold-bed: the primary bed continuing without a jump over real dead time under a replay, freeze, card or B-roll. alt-bed: another source's audio; from a match source, only under live segments (court audio never plays unchecked under a replay, freeze, card or B-roll). Every change of bed source (to or from alt-bed, back to the primary, or to or from silence), and every jump to another position of the same source, sits on a segment boundary: at a cut each sounding side fades at least 20 ms; at a dissolve or dip the switch is an audio dip spanning the picture transition. silence: explicit. Narration (consented, ducked, disclosed when generated) and music (rights record) are optional lanes over the bed.",
      "type": "object",
      "required": ["primarySourceId", "bed", "narration", "music"],
      "additionalProperties": false,
      "properties": {
        "primarySourceId": {"oneOf": [{"type": "null"}, {"$ref": "studio-common.schema.json#/$defs/id"}]},
        "bed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["route", "sourceId", "sourceInFrame", "outputInFrame", "outputOutFrame", "fadeInMs", "fadeOutMs"],
            "additionalProperties": false,
            "properties": {
              "route": {"$ref": "studio-common.schema.json#/$defs/audioRoute"},
              "sourceId": {"oneOf": [{"type": "null"}, {"$ref": "studio-common.schema.json#/$defs/id"}]},
              "sourceInFrame": {"type": ["integer", "null"], "minimum": 0},
              "outputInFrame": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
              "outputOutFrame": {"$ref": "studio-common.schema.json#/$defs/posInt"},
              "fadeInMs": {"type": "integer", "minimum": 0, "maximum": 2000},
              "fadeOutMs": {"type": "integer", "minimum": 0, "maximum": 2000}
            }
          }
        },
        "narration": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["voice", "consent", "disclosureTemplateId", "duckDb", "scriptNoteIds", "windows"],
              "additionalProperties": false,
              "properties": {
                "voice": {"enum": ["user-recorded", "generated"]},
                "consent": {
                  "type": "object",
                  "required": ["consentRecordId", "granted"],
                  "additionalProperties": false,
                  "properties": {"consentRecordId": {"$ref": "studio-common.schema.json#/$defs/id"}, "granted": {"type": "boolean"}}
                },
                "disclosureTemplateId": {"oneOf": [{"type": "null"}, {"const": "label.narration-generated"}]},
                "duckDb": {"type": "integer", "minimum": -24, "maximum": -6},
                "scriptNoteIds": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "studio-common.schema.json#/$defs/id"}},
                "windows": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/outputWindow"}}
              }
            }
          ]
        },
        "music": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["assetId", "rightsRecordId", "rightsScope", "windows"],
              "additionalProperties": false,
              "properties": {
                "assetId": {"$ref": "studio-common.schema.json#/$defs/id"},
                "rightsRecordId": {"$ref": "studio-common.schema.json#/$defs/id"},
                "rightsScope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["private-film", "lesson-share", "youtube"]}},
                "windows": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/outputWindow"}}
              }
            }
          ]
        }
      }
    }
  }
}
