{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JOVRA Studio RenderJob (jovra.render-job/1)",
  "description": "A private production job and its full transition history. The state machine lives in spec/studio/contracts/render-job-transitions.v1.json; spec/reference/studio/jobstate.py replays the history and must arrive at the stored state, resumeStage and attempt. Paid stages need a reservation; ready needs a verified delivered artifact. Stage progress is a per-stage figure, never a computed whole-job percentage.",
  "type": "object",
  "required": ["schemaVersion", "jobId", "projectId", "environment", "sample", "planId", "planRevision", "quoteId", "reservationId", "idempotencyKey", "state", "resumeStage", "attempt", "maxAttempts", "stageProgress", "deliveredArtifactIds", "history"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "jovra.render-job/1"},
    "jobId": {"$ref": "studio-common.schema.json#/$defs/id"},
    "projectId": {"$ref": "studio-common.schema.json#/$defs/id"},
    "environment": {"$ref": "studio-common.schema.json#/$defs/environment"},
    "sample": {"$ref": "studio-common.schema.json#/$defs/sample"},
    "planId": {"oneOf": [{"type": "null"}, {"$ref": "studio-common.schema.json#/$defs/id"}]},
    "planRevision": {"oneOf": [{"type": "null"}, {"$ref": "studio-common.schema.json#/$defs/revision"}]},
    "quoteId": {"oneOf": [{"type": "null"}, {"$ref": "studio-common.schema.json#/$defs/id"}]},
    "reservationId": {"oneOf": [{"type": "null"}, {"$ref": "studio-common.schema.json#/$defs/id"}]},
    "idempotencyKey": {"description": "Canonical SHA-256 of (projectId, planRevision, outputSpec); the same request never starts a second job.", "$ref": "studio-common.schema.json#/$defs/sha256"},
    "state": {"$ref": "#/$defs/state"},
    "resumeStage": {"description": "Set only in paused, failed_retryable and budget_exceeded: one of pausableFrom / retryableFrom / budgetExceededFrom for that state (jobstate.py checks which). Never ready, deleted or any terminal state.", "oneOf": [{"type": "null"}, {"$ref": "#/$defs/resumeStage"}]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 100},
    "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 100},
    "stageProgress": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["stage", "percent", "sample"],
          "additionalProperties": false,
          "properties": {
            "stage": {"$ref": "#/$defs/state"},
            "percent": {"type": "integer", "minimum": 0, "maximum": 100},
            "sample": {"type": "boolean"}
          }
        }
      ]
    },
    "deliveredArtifactIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "studio-common.schema.json#/$defs/id"}},
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["seq", "from", "to", "at", "reason"],
        "additionalProperties": false,
        "properties": {
          "seq": {"$ref": "studio-common.schema.json#/$defs/nonNegInt"},
          "from": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/state"}]},
          "to": {"$ref": "#/$defs/state"},
          "at": {"$ref": "studio-common.schema.json#/$defs/dateTime"},
          "reason": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"}
        }
      }
    }
  },
  "$defs": {
    "resumeStage": {
      "description": "pausableFrom U retryableFrom U budgetExceededFrom of spec/studio/contracts/render-job-transitions.v1.json; validate_studio.py fails if they drift.",
      "enum": ["upload_pending", "uploading", "queued", "normalizing", "syncing", "analyzing", "planning", "preview_rendering", "awaiting_review", "final_rendering", "verifying"]
    },
    "state": {
      "enum": ["draft", "quoted", "consented", "upload_pending", "uploading", "queued", "normalizing", "syncing", "analyzing", "planning", "preview_rendering", "awaiting_review", "final_rendering", "verifying", "ready", "paused", "canceled", "failed_retryable", "failed_terminal", "quote_expired", "budget_exceeded", "deleted"]
    }
  }
}
