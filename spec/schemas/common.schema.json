{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JOVRA shared definitions",
  "description": "Definitions shared by every JOVRA record. Not a document type on its own. No $id: references resolve relative to this file.",
  "$defs": {
    "schemaVersion": {
      "description": "Semantic version of the record's schema. Major 1 for every v1 record; minor bumps are additive.",
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "description": "Opaque identifier. Apps generate UUIDs; fixtures may use short readable ids.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "dateTime": {
      "description": "RFC 3339 timestamp in UTC with a Z suffix.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timeZone": {
      "description": "IANA time zone name, e.g. America/Chicago.",
      "type": "string",
      "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$"
    },
    "sport": {
      "description": "Sport-agnostic where cheap. v1 ships tennis only.",
      "enum": ["tennis"]
    },
    "side": {
      "description": "One of the two competing sides. Singles: one player per side; doubles: a team of two.",
      "enum": ["A", "B"]
    },
    "sideCounts": {
      "type": "object",
      "required": ["A", "B"],
      "additionalProperties": false,
      "properties": {
        "A": {"type": "integer", "minimum": 0},
        "B": {"type": "integer", "minimum": 0}
      }
    },
    "provenanceStatus": {
      "description": "How a value was produced (ADR-0004, CLAUDE.md hard rule 1).",
      "enum": ["manual", "estimated", "reviewed", "validated"]
    },
    "source": {
      "description": "Who produced a value: the user, a model/capability (model:<name>@<version>), a deterministic rule (rule:<name>@<version>), an import, or the sample generator.",
      "type": "string",
      "pattern": "^(user|model:[A-Za-z0-9._-]+@[A-Za-z0-9._+-]+|rule:[A-Za-z0-9._-]+@[A-Za-z0-9._+-]+|import:[A-Za-z0-9._-]+|sample:[A-Za-z0-9._-]+@[A-Za-z0-9._+-]+)$"
    },
    "provenance": {
      "description": "Attached to every derived value: status, producer, capability, confidence, calibration dependency and denominator.",
      "type": "object",
      "required": ["status", "source"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/provenanceStatus"},
        "source": {"$ref": "#/$defs/source"},
        "capabilityId": {"$ref": "#/$defs/capabilityId"},
        "capabilityVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "calibrationId": {"$ref": "#/$defs/id"},
        "denominator": {"type": "integer", "minimum": 0},
        "computedAt": {"$ref": "#/$defs/dateTime"},
        "sample": {"type": "boolean", "description": "True for demo/sample data, which the UI must badge 'Sample'."}
      }
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)*$"
    },
    "ratio": {
      "description": "A displayed rate. pct = (200n + d) div 2d (half-up, integers only); d = 0 -> pct null, display '—'.",
      "type": "object",
      "required": ["n", "d", "pct", "display"],
      "additionalProperties": false,
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "d": {"type": "integer", "minimum": 0},
        "pct": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "display": {"type": "string"}
      }
    },
    "decimalString": {
      "description": "An exact decimal as text, so no platform rounds it through binary floating point.",
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "tension": {
      "description": "String tension AS ENTERED. Never round-tripped through the other unit.",
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/decimalString"},
        "unit": {"enum": ["lb", "kg"]}
      }
    },
    "length": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/decimalString"},
        "unit": {"enum": ["mm", "cm", "m", "in", "ft"]}
      }
    },
    "area": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/decimalString"},
        "unit": {"enum": ["cm2", "in2"]}
      }
    },
    "mass": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/decimalString"},
        "unit": {"enum": ["g", "oz"]}
      }
    },
    "speed": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/decimalString"},
        "unit": {"enum": ["mph", "km/h", "m/s"]}
      }
    },
    "money": {
      "type": "object",
      "required": ["amountMinor", "currency"],
      "additionalProperties": false,
      "properties": {
        "amountMinor": {"type": "integer", "minimum": 0, "description": "Amount in minor units (cents)."},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "timeMs": {
      "description": "Milliseconds on the session timeline (0 = start of the first recording segment).",
      "type": "integer",
      "minimum": 0
    },
    "frameRate": {
      "description": "Nominal frame rate as a rational (60000/1001 for 59.94).",
      "type": "object",
      "required": ["num", "den"],
      "additionalProperties": false,
      "properties": {
        "num": {"type": "integer", "minimum": 1},
        "den": {"type": "integer", "minimum": 1}
      }
    },
    "relativePath": {
      "description": "Path relative to the session folder; no parent traversal.",
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9 ._()/-]{1,255}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "fileRef": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "mimeType": {"type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "md5": {"$ref": "#/$defs/md5"}
      }
    },
    "point2": {
      "description": "A 2D point. Image space is normalized 0..1 (origin top-left); court space is metres (origin at the centre of the net, x across, y along the court towards the far baseline).",
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    },
    "appInfo": {
      "type": "object",
      "required": ["name", "version", "platform"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "JOVRA"},
        "version": {"type": "string", "minLength": 1, "maxLength": 32},
        "build": {"type": "string", "maxLength": 32},
        "platform": {"enum": ["ios", "android", "reference"]}
      }
    }
  }
}
