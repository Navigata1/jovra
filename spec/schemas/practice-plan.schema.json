{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JOVRA practice plan",
  "description": "Evidence-linked practice (P1-06): deterministic rules over computed stats, each item carrying the evidence row and clips that triggered it. Labelled 'Suggested practice'; fully editable.",
  "$comment": "Schema 1.1.0 (T02) added, all optional: drillLogs (drill session logs), goals[].window / targetDate / createdAt, items[].drill.sets. A document stamped 1.0.x may carry none of them ($defs/v1_0).",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "createdAt", "updatedAt", "title", "label", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "kind": {"const": "jovra.practicePlan"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "createdAt": {"$ref": "common.schema.json#/$defs/dateTime"},
    "updatedAt": {"$ref": "common.schema.json#/$defs/dateTime"},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "label": {"const": "Suggested practice"},
    "sample": {"type": "boolean"},
    "playerId": {"$ref": "common.schema.json#/$defs/id"},
    "basedOnSessions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "goals": {"type": "array", "items": {"$ref": "#/$defs/goal"}},
    "drillLogs": {"type": "array", "items": {"$ref": "#/$defs/drillLog"}, "description": "Since 1.1.0. One entry per drill session (S15 drillSession)."}
  },
  "allOf": [
    {
      "if": {"required": ["schemaVersion"], "properties": {"schemaVersion": {"pattern": "^1\\.0\\."}}},
      "then": {"$ref": "#/$defs/v1_0"}
    }
  ],
  "$defs": {
    "v1_0": {
      "description": "What a document stamped 1.0.x may not hold: every field and enum value added in 1.1.0. A 1.0 reader decodes closed objects and rejects them, so a writer that uses any of them stamps 1.1.0 or later.",
      "properties": {
        "items": {"items": {"properties": {"drill": {"properties": {"sets": false}}}}},
        "goals": {"items": {"properties": {"window": false, "targetDate": false, "createdAt": false}}},
        "drillLogs": false
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "focus", "drill", "origin", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "focus": {"type": "string", "minLength": 1, "maxLength": 80, "description": "e.g. 'Build a repeatable toss'."},
        "drill": {
          "type": "object",
          "required": ["title", "instructions"],
          "additionalProperties": false,
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 80},
            "instructions": {"type": "string", "minLength": 1, "maxLength": 1000},
            "durationMinutes": {"type": "integer", "minimum": 1, "maximum": 180},
            "sets": {"type": "integer", "minimum": 1, "maximum": 50, "description": "Since 1.1.0 ('3 sets of 10')."},
            "reps": {"type": "integer", "minimum": 1, "maximum": 1000, "description": "Repetitions per set when sets is present."}
          }
        },
        "origin": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "ruleId", "ruleVersion", "condition"],
              "additionalProperties": false,
              "properties": {
                "kind": {"const": "rule"},
                "ruleId": {"$ref": "common.schema.json#/$defs/capabilityId"},
                "ruleVersion": {"type": "string", "minLength": 1, "maxLength": 16},
                "condition": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Human-readable, e.g. 'firstServePointsWon.pct < 72'."}
              }
            },
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {"kind": {"const": "user"}}
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sessionId", "stat", "value", "provenance", "availability"],
            "additionalProperties": false,
            "properties": {
              "sessionId": {"$ref": "common.schema.json#/$defs/id"},
              "stat": {"type": "string", "minLength": 1, "maxLength": 80},
              "side": {"$ref": "common.schema.json#/$defs/side"},
              "value": {"$ref": "common.schema.json#/$defs/ratio"},
              "text": {"type": "string", "maxLength": 120, "description": "e.g. '28 of 40 first-serve points won'."},
              "pointIds": {"type": "array", "maxItems": 50, "items": {"$ref": "common.schema.json#/$defs/id"}},
              "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
              "availability": {"enum": ["available", "videoUnavailable", "sessionDeleted"]}
            }
          }
        },
        "status": {"enum": ["planned", "done", "skipped"]},
        "userEdited": {"type": "boolean"}
      }
    },
    "goal": {
      "type": "object",
      "required": ["id", "stat", "target", "sessionKind"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "stat": {"type": "string", "minLength": 1, "maxLength": 80},
        "target": {"type": "integer", "minimum": 0, "maximum": 100, "description": "Target displayed percentage."},
        "sessionKind": {"enum": ["match", "tiebreakOnly", "practiceSet", "servePractice", "strokePractice", "rally", "lesson", "drill"]},
        "achievedAt": {"$ref": "common.schema.json#/$defs/dateTime"},
        "window": {"enum": ["fourWeeks", "threeMonths", "year"], "description": "Since 1.1.0. The progress window the goal is evaluated over ('over 4 weeks')."},
        "targetDate": {"$ref": "common.schema.json#/$defs/date", "description": "Since 1.1.0 (story 285: a goal with a target and date)."},
        "createdAt": {"$ref": "common.schema.json#/$defs/dateTime", "description": "Since 1.1.0. When the goal was set; its progress window starts here."}
      }
    },
    "drillLog": {
      "description": "Since 1.1.0. A drill session: timer, set counter and the manual In / Out tally saved as a practice log. Finishing it marks the drill done and advances linked goals.",
      "type": "object",
      "required": ["id", "itemId", "startedAt", "status", "setsCompleted"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "itemId": {"$ref": "common.schema.json#/$defs/id", "description": "The plan item whose drill was run."},
        "drillTitle": {"type": "string", "minLength": 1, "maxLength": 80, "description": "Snapshot, so the log stays readable after the plan is edited."},
        "startedAt": {"$ref": "common.schema.json#/$defs/dateTime"},
        "finishedAt": {"$ref": "common.schema.json#/$defs/dateTime"},
        "activeSeconds": {"type": "integer", "minimum": 0, "description": "Timer time, pauses excluded."},
        "status": {"enum": ["inProgress", "finished", "abandoned"]},
        "setsPlanned": {"type": "integer", "minimum": 1, "maximum": 50},
        "setsCompleted": {"type": "integer", "minimum": 0, "maximum": 50},
        "tally": {
          "type": "object",
          "required": ["in", "out"],
          "additionalProperties": false,
          "properties": {
            "in": {"type": "integer", "minimum": 0},
            "out": {"type": "integer", "minimum": 0}
          }
        },
        "recordedSessionId": {"$ref": "common.schema.json#/$defs/id", "description": "The session recorded with 'Record this drill'."},
        "goalIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
        "sample": {"type": "boolean"}
      }
    }
  }
}
