{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JOVRA sample-match fixture",
  "description": "Expected outputs for the Jon vs Alex sample session. The engine input is built from the session document (match.format, match.toss, sides, players, match.log). 'overview' holds the screen-9 numbers copied by hand from the brief.",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "title", "covers", "sessionFile", "csv", "seed", "overview", "constraints", "expected"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "kind": {"const": "jovra.fixture.sample"},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "covers": {"type": "array", "items": {"type": "string"}},
    "sessionFile": {"$ref": "common.schema.json#/$defs/relativePath"},
    "csv": {
      "type": "object",
      "required": ["points", "stats"],
      "additionalProperties": false,
      "properties": {
        "points": {"$ref": "common.schema.json#/$defs/relativePath"},
        "stats": {"$ref": "common.schema.json#/$defs/relativePath"}
      }
    },
    "seed": {"type": "integer", "minimum": 0},
    "overview": {
      "type": "object",
      "required": ["scoreline", "durationMs", "points", "pointsWon", "firstServeIn", "firstServePointsWon", "shots", "reviewed", "flagged", "reviewCompletion"],
      "additionalProperties": false,
      "properties": {
        "scoreline": {"type": "string"},
        "durationMs": {"type": "integer", "minimum": 0},
        "points": {"type": "integer", "minimum": 0},
        "pointsWon": {"$ref": "common.schema.json#/$defs/ratio"},
        "firstServeIn": {"$ref": "common.schema.json#/$defs/ratio"},
        "firstServePointsWon": {"$ref": "common.schema.json#/$defs/ratio"},
        "shots": {"type": "integer", "minimum": 0},
        "reviewed": {"type": "integer", "minimum": 0},
        "flagged": {"type": "integer", "minimum": 0},
        "reviewCompletion": {"$ref": "common.schema.json#/$defs/ratio"}
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "kind", "status", "detail"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^C(1[0-6]|[1-9])$"},
          "kind": {"enum": ["hard", "soft"]},
          "status": {"enum": ["pass", "partial"], "description": "partial: every checked clause holds and the rest are waived by a named decision (listed in waived)."},
          "detail": {"type": "string", "description": "The clauses that were checked."},
          "waived": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["clause", "decision", "reason", "observed", "met"],
              "additionalProperties": false,
              "properties": {
                "clause": {"type": "string"},
                "decision": {"type": "string", "pattern": "^D[0-9]+$"},
                "reason": {"type": "string"},
                "observed": {"type": "string"},
                "met": {"type": "boolean"}
              }
            }
          }
        },
        "if": {"properties": {"status": {"const": "partial"}}},
        "then": {"required": ["waived"]},
        "else": {"not": {"required": ["waived"]}}
      }
    },
    "expected": {
      "type": "object",
      "required": ["fold", "stats"],
      "additionalProperties": false,
      "properties": {
        "fold": {"$ref": "engine-output.schema.json#/$defs/foldResult"},
        "stats": {"$ref": "engine-output.schema.json#/$defs/statsResult"}
      }
    }
  }
}
