{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JOVRA label scoring conformance vectors (spec/benchmarks/scoring/L*.json)",
  "description": "V01: a synthetic label document, a stage's observations and the metrics the label scorer must print for the tuning and the held-out windows. Every expected value was worked by hand (`worked` shows the arithmetic); the reference is spec/reference/jovra_ref/labels.py and the Swift twin is JovraBenchmark.LabelScorer. Nothing here comes from real footage.",
  "$comment": "Schema 1.0.0, added by V01.",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "title", "covers", "worked", "tolerances", "labels", "observations", "expected"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "kind": {"const": "jovra.fixture.labelScoring"},
    "id": {"type": "string", "pattern": "^L[0-9]{2}-[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "covers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "worked": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "The hand computation, one step per line."},
    "tolerances": {
      "type": "object",
      "required": ["hit", "bounce", "rallyBoundary"],
      "additionalProperties": false,
      "properties": {
        "hit": {"$ref": "common.schema.json#/$defs/mediaTime"},
        "bounce": {"$ref": "common.schema.json#/$defs/mediaTime"},
        "rallyBoundary": {"$ref": "common.schema.json#/$defs/mediaTime"}
      }
    },
    "labels": {"$ref": "benchmark-labels.schema.json"},
    "observations": {"$ref": "benchmark-observations.schema.json"},
    "expected": {
      "type": "object",
      "required": ["tuning", "heldOut"],
      "additionalProperties": false,
      "properties": {
        "tuning": {"$ref": "#/$defs/splitResult"},
        "heldOut": {"$ref": "#/$defs/splitResult"}
      }
    }
  },
  "$defs": {
    "splitResult": {
      "type": "object",
      "required": ["windows", "durationMs", "rows"],
      "additionalProperties": false,
      "properties": {
        "windows": {"type": "integer", "minimum": 0},
        "durationMs": {"type": "integer", "minimum": 0},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
      }
    },
    "row": {
      "type": "object",
      "required": ["group", "name", "value"],
      "additionalProperties": false,
      "description": "One printed metric. `value` is the text shown (null when undefined, 0/0). `exact` is present for exact rational metrics; counts and pixel distances have none.",
      "properties": {
        "group": {"enum": ["hits", "bounces", "rally boundaries", "court corners", "coverage"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "unit": {"enum": ["ms", "px"]},
        "value": {"type": ["string", "null"], "pattern": "^[+-]?[0-9]+(\\.[0-9]+)?$"},
        "exact": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "required": ["n", "d"], "additionalProperties": false, "properties": {"n": {"type": "integer"}, "d": {"type": "integer", "minimum": 1}}}
          ]
        }
      }
    }
  }
}
