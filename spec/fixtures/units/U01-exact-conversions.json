{
  "schemaVersion": "1.0.0",
  "kind": "jovra.fixture.units",
  "id": "U01-exact-conversions",
  "title": "Exact factors, one half-up rounding for display, stored values never round-tripped, gauge is a hint",
  "covers": ["§7 rule 6", "raw/equipment-stringing.md §4, §4a"],
  "cases": [
    {
      "op": "convert",
      "value": "52",
      "from": "lb",
      "to": "kg",
      "places": 8,
      "expected": {"value": "23.58680324"}
    },
    {
      "op": "convert",
      "value": "104",
      "from": "mph",
      "to": "km/h",
      "places": 3,
      "expected": {"value": "167.372"}
    },
    {
      "op": "convert",
      "value": "23",
      "from": "kg",
      "to": "lb",
      "places": 6,
      "expected": {"value": "50.706320"}
    },
    {
      "op": "convert",
      "value": "1",
      "from": "mph",
      "to": "m/s",
      "places": 5,
      "expected": {"value": "0.44704"}
    },
    {
      "op": "convert",
      "value": "1",
      "from": "lb",
      "to": "N",
      "places": 13,
      "expected": {"value": "4.4482216152605"}
    },
    {
      "op": "convert",
      "value": "98",
      "from": "in2",
      "to": "cm2",
      "places": 4,
      "expected": {"value": "632.2568"}
    },
    {
      "op": "convert",
      "value": "1",
      "from": "oz",
      "to": "g",
      "places": 9,
      "expected": {"value": "28.349523125"}
    },
    {
      "op": "convert",
      "value": "40",
      "from": "ft",
      "to": "m",
      "places": 3,
      "expected": {"value": "12.192"}
    },
    {
      "op": "convert",
      "value": "27",
      "from": "in",
      "to": "cm",
      "places": 2,
      "expected": {"value": "68.58"}
    },
    {
      "op": "display",
      "value": "52",
      "unit": "lb",
      "preferredUnit": "lb",
      "expected": {"value": "52", "unit": "lb", "converted": false}
    },
    {
      "op": "display",
      "value": "52.0",
      "unit": "lb",
      "preferredUnit": "lb",
      "expected": {"value": "52.0", "unit": "lb", "converted": false}
    },
    {
      "op": "display",
      "value": "52",
      "unit": "lb",
      "preferredUnit": "kg",
      "expected": {"value": "23.6", "unit": "kg", "converted": true}
