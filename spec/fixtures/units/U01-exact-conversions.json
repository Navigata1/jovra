    {
      "op": "gaugeHint",
      "label": "17",
      "expected": {
        "label": "17",
        "known": true,
        "ranges": [
          {"source": "tennisCompanion", "minMm": "1.16", "maxMm": "1.24"},
          {"source": "tennisWarehouse", "minMm": "1.20", "maxMm": "1.25"}
