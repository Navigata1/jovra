{
  "schemaVersion": "1.2.0",
  "kind": "jovra.fixture.trend",
  "id": "TR01-pooled-trends",
  "title": "Trends pool numerators and denominators per bucket, hide small buckets, take deltas from displayed integers and keep sample sessions apart",
  "covers": ["§6.10", "§7 rule 4", "screens S03", "screens S16", "stories 32, 34, 280, 282"],
  "defaultMinimums": {"bucketDenominator": 20, "pooledDenominator": 100, "bucketsWithData": 2},
  "cases": [
    {
      "name": "pool-not-average",
      "title": "Pooling 1/2 with 30/40 gives 31/42 = 74%, not the 62.5% average",
      "input": {
        "range": "4W",
        "asOf": "2026-10-06",
        "comparableKind": "singlesMatch",
        "scope": "real",
        "sessions": [
          {"id": "a", "date": "2026-10-01", "comparableKind": "singlesMatch", "sample": false, "n": 1, "d": 2},
          {"id": "b", "date": "2026-10-05", "comparableKind": "singlesMatch", "sample": false, "n": 30, "d": 40}
        ]
      },
      "assertions": [
        {"path": "buckets[3].ratio", "equals": {"n": 31, "d": 42, "pct": 74, "display": "74%"}},
        {"path": "buckets[3].sessionIds", "equals": ["a", "b"]},
        {"path": "buckets[3].hidden", "equals": false},
        {"path": "buckets[0].ratio", "equals": {"n": 0, "d": 0, "pct": null, "display": "—"}},
        {"path": "buckets[0].hidden", "equals": true},
        {"path": "state", "equals": "tooFewComparable"},
        {"path": "headline", "equals": null},
        {"path": "sessionCount", "equals": 2}
      ],
      "expected": {
        "state": "tooFewComparable",
        "buckets": [
          {"index": 0, "from": "2026-09-09", "to": "2026-09-15", "sessionIds": [], "ratio": {"n": 0, "d": 0, "pct": null, "display": "—"}, "hidden": true},
          {"index": 1, "from": "2026-09-16", "to": "2026-09-22", "sessionIds": [], "ratio": {"n": 0, "d": 0, "pct": null, "display": "—"}, "hidden": true},
          {"index": 2, "from": "2026-09-23", "to": "2026-09-29", "sessionIds": [], "ratio": {"n": 0, "d": 0, "pct": null, "display": "—"}, "hidden": true},
          {"index": 3, "from": "2026-09-30", "to": "2026-10-06", "sessionIds": ["a", "b"], "ratio": {"n": 31, "d": 42, "pct": 74, "display": "74%"}, "hidden": false}
        ],
        "pooled": {"n": 31, "d": 42, "pct": 74, "display": "74%"},
        "sessionCount": 2,
        "excluded": {"otherScope": 0, "otherKind": 0, "outsideWindow": 0},
        "headline": null
      }
    },
    {
      "name": "weekly-first-serves-in",
      "title": "Weekly first serves in 48, 55, 63, 67 and +4 percentage points from displayed integers",
      "input": {
        "range": "4W",
        "asOf": "2026-10-06",
        "comparableKind": "singlesMatch",
        "scope": "real",
        "sessions": [
          {"id": "w1", "date": "2026-09-12", "comparableKind": "singlesMatch", "sample": false, "n": 24, "d": 50},
          {"id": "w2", "date": "2026-09-19", "comparableKind": "singlesMatch", "sample": false, "n": 33, "d": 60},
          {"id": "w3", "date": "2026-09-26", "comparableKind": "singlesMatch", "sample": false, "n": 38, "d": 60},
          {"id": "w4", "date": "2026-10-06", "comparableKind": "singlesMatch", "sample": false, "n": 40, "d": 60}
        ]
      },
      "assertions": [
        {"path": "buckets[0].from", "equals": "2026-09-09"},
        {"path": "buckets[0].to", "equals": "2026-09-15"},
        {"path": "buckets[3].from", "equals": "2026-09-30"},
        {"path": "buckets[3].to", "equals": "2026-10-06"},
        {"path": "buckets[0].ratio.pct", "equals": 48},
        {"path": "buckets[1].ratio.pct", "equals": 55},
        {"path": "buckets[2].ratio.pct", "equals": 63},
        {"path": "buckets[3].ratio.pct", "equals": 67},
        {"path": "headline.deltaPoints", "equals": 4},
        {"path": "headline.deltaText", "equals": "+4 percentage points"},
        {"path": "pooled", "equals": {"n": 135, "d": 230, "pct": 59, "display": "59%"}},
        {"path": "state", "equals": "ok"}
      ],
      "expected": {
        "state": "ok",
        "buckets": [
          {"index": 0, "from": "2026-09-09", "to": "2026-09-15", "sessionIds": ["w1"], "ratio": {"n": 24, "d": 50, "pct": 48, "display": "48%"}, "hidden": false},
          {"index": 1, "from": "2026-09-16", "to": "2026-09-22", "sessionIds": ["w2"], "ratio": {"n": 33, "d": 60, "pct": 55, "display": "55%"}, "hidden": false},
          {"index": 2, "from": "2026-09-23", "to": "2026-09-29", "sessionIds": ["w3"], "ratio": {"n": 38, "d": 60, "pct": 63, "display": "63%"}, "hidden": false},
          {"index": 3, "from": "2026-09-30", "to": "2026-10-06", "sessionIds": ["w4"], "ratio": {"n": 40, "d": 60, "pct": 67, "display": "67%"}, "hidden": false}
        ],
        "pooled": {"n": 135, "d": 230, "pct": 59, "display": "59%"},
        "sessionCount": 4,
        "excluded": {"otherScope": 0, "otherKind": 0, "outsideWindow": 0},
        "headline": {
          "currentIndex": 3,
          "priorIndex": 2,
          "current": {"n": 40, "d": 60, "pct": 67, "display": "67%"},
          "prior": {"n": 38, "d": 60, "pct": 63, "display": "63%"},
          "deltaPoints": 4,
          "deltaText": "+4 percentage points"
        }
      }
    },
    {
      "name": "hidden-small-buckets",
      "title": "Buckets below the minimum denominator are hidden and skipped by the headline",
      "input": {
        "range": "4W",
        "asOf": "2026-10-06",
        "comparableKind": "singlesMatch",
        "scope": "real",
        "sessions": [
          {"id": "w1", "date": "2026-09-10", "comparableKind": "singlesMatch", "sample": false, "n": 30, "d": 50},
          {"id": "w2", "date": "2026-09-17", "comparableKind": "singlesMatch", "sample": false, "n": 40, "d": 60},
          {"id": "w3", "date": "2026-09-24", "comparableKind": "singlesMatch", "sample": false, "n": 5, "d": 10},
          {"id": "w4", "date": "2026-10-02", "comparableKind": "singlesMatch", "sample": false, "n": 3, "d": 4}
        ]
      },
      "assertions": [
        {"path": "buckets[2].hidden", "equals": true},
        {"path": "buckets[3].hidden", "equals": true},
        {"path": "buckets[2].ratio", "equals": {"n": 5, "d": 10, "pct": 50, "display": "50%"}},
        {"path": "headline.currentIndex", "equals": 1},
        {"path": "headline.priorIndex", "equals": 0},
        {"path": "headline.current", "equals": {"n": 40, "d": 60, "pct": 67, "display": "67%"}},
        {"path": "headline.prior", "equals": {"n": 30, "d": 50, "pct": 60, "display": "60%"}},
        {"path": "headline.deltaText", "equals": "+7 percentage points"},
        {"path": "pooled", "equals": {"n": 78, "d": 124, "pct": 63, "display": "63%"}}
      ],
      "expected": {
        "state": "ok",
        "buckets": [
          {"index": 0, "from": "2026-09-09", "to": "2026-09-15", "sessionIds": ["w1"], "ratio": {"n": 30, "d": 50, "pct": 60, "display": "60%"}, "hidden": false},
          {"index": 1, "from": "2026-09-16", "to": "2026-09-22", "sessionIds": ["w2"], "ratio": {"n": 40, "d": 60, "pct": 67, "display": "67%"}, "hidden": false},
          {"index": 2, "from": "2026-09-23", "to": "2026-09-29", "sessionIds": ["w3"], "ratio": {"n": 5, "d": 10, "pct": 50, "display": "50%"}, "hidden": true},
          {"index": 3, "from": "2026-09-30", "to": "2026-10-06", "sessionIds": ["w4"], "ratio": {"n": 3, "d": 4, "pct": 75, "display": "75%"}, "hidden": true}
        ],
        "pooled": {"n": 78, "d": 124, "pct": 63, "display": "63%"},
        "sessionCount": 4,
        "excluded": {"otherScope": 0, "otherKind": 0, "outsideWindow": 0},
        "headline": {
          "currentIndex": 1,
          "priorIndex": 0,
          "current": {"n": 40, "d": 60, "pct": 67, "display": "67%"},
          "prior": {"n": 30, "d": 50, "pct": 60, "display": "60%"},
          "deltaPoints": 7,
          "deltaText": "+7 percentage points"
        }
      }
    },
    {
      "name": "sample-excluded",
