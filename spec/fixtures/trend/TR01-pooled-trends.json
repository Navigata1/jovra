        "pooled": {"n": 85, "d": 120, "pct": 71, "display": "71%"},
        "sessionCount": 2,
        "excluded": {"otherScope": 1, "otherKind": 0, "outsideWindow": 0},
        "headline": {
          "currentIndex": 3,
          "priorIndex": 2,
          "current": {"n": 45, "d": 60, "pct": 75, "display": "75%"},
          "prior": {"n": 40, "d": 60, "pct": 67, "display": "67%"},
