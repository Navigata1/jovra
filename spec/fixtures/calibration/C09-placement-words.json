      "op": "describe",
      "name": "the story's example",
      "landing": {"x": -3.0, "y": 10.0},
      "hitterX": 2.0,
      "result": "in",
      "doubles": false,
      "expected": {
        "depth": "deep",
        "direction": "crossCourt",
        "wide": false,
        "result": "in",
        "english": "Deep cross-court, in"
      }
    },
    {
      "op": "describe",
      "name": "down the line, short",
      "landing": {"x": 3.0, "y": 4.0},
      "hitterX": 2.0,
      "result": "in",
      "doubles": false,
      "expected": {
        "depth": "short",
        "direction": "downTheLine",
        "wide": false,
        "result": "in",
        "english": "Short down the line, in"
      }
    },
    {
      "op": "describe",
      "name": "middle third",
      "landing": {"x": 0.8, "y": 9.0},
      "hitterX": -2.5,
      "result": "needsReview",
      "doubles": false,
      "expected": {
        "depth": "deep",
        "direction": "middle",
        "wide": false,
        "result": "needsReview",
        "english": "Deep middle, needs review"
      }
    },
    {
      "op": "describe",
      "name": "no hitter position: sides as seen from the hitter's end",
      "landing": {"x": -3.0, "y": 9.0},
