      "result": "in",
      "doubles": false,
      "expected": {"depth": "deep", "direction": "left", "wide": false, "result": "in", "english": "Deep left, in"}
    },
    {
      "op": "describe",
      "name": "beyond the baseline",
      "landing": {"x": 1.0, "y": 12.4},
      "hitterX": null,
      "result": "out",
      "doubles": false,
      "expected": {
        "depth": "long",
        "direction": "middle",
        "wide": false,
        "result": "out",
        "english": "Long middle, out"
      }
    },
    {
      "op": "describe",
      "name": "singles: the alley is wide",
      "landing": {"x": 4.6, "y": 8.0},
      "hitterX": -1.0,
      "result": "out",
      "doubles": false,
      "expected": {
        "depth": "deep",
        "direction": "crossCourt",
        "wide": true,
        "result": "out",
        "english": "Deep cross-court, wide, out"
      }
    },
    {
      "op": "describe",
      "name": "doubles: the alley is in",
      "landing": {"x": 4.6, "y": 8.0},
      "hitterX": -1.0,
      "result": "in",
      "doubles": true,
      "expected": {
        "depth": "deep",
        "direction": "crossCourt",
        "wide": false,
        "result": "in",
        "english": "Deep cross-court, in"
      }
    },
    {
      "op": "describe",
      "name": "on the service line is short",
      "landing": {"x": -2.0, "y": 6.4},
      "hitterX": null,
      "result": "in",
      "doubles": false,
      "expected": {"depth": "short", "direction": "left", "wide": false, "result": "in", "english": "Short left, in"}
