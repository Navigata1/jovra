{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Info.plist NSCameraUsageDescription",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JOVRA uses the camera to record your tennis sessions. Videos are saved on this device."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Info.plist NSHealthUpdateUsageDescription",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you turn on Apple Health in Settings, JOVRA saves each tennis session as a workout with only its start time, end time and session reference, nothing else."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Info.plist NSMicrophoneUsageDescription",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. JOVRA can use the microphone to capture audio for hit detection and voice notes. Recording works without it."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Info.plist NSPhotoLibraryAddUsageDescription",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JOVRA saves clips and exports you choose to your photo library."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
