{
  "sourceLanguage": "en",
  "strings": {
    "%@ · %@": {
      "comment": "Frame readout followed by the playback rate, e.g. “… · 0.5×”",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%@ · %@ fps": {
      "comment": "Frame readout without the frame number",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ fps"
          }
        }
      }
    },
    "Frame %@, %@": {
      "comment": "VoiceOver value of the jog strip, e.g. “Frame 46,000, 12:46.67”",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame %@, %@"
          }
        }
      }
    },
    "Frame %@, %@ of %@": {
      "comment": "VoiceOver value of the timeline, e.g. “Frame 750, 0:12.50 of 0:54.00”",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame %@, %@ of %@"
          }
        }
      }
    },
