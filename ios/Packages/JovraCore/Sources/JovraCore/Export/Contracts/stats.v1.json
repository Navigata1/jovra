{
  "schemaVersion": "1.0.0",
  "kind": "jovra.csvContract",
  "name": "stats",
  "version": 1,
  "description": "One row per stat (per side where the stat is per side), in the order of 'rows'. Rates keep their numerator and denominator; pct uses the shared integer rule and is empty when the denominator is 0.",
  "encoding": "utf-8",
  "byteOrderMark": false,
  "delimiter": ",",
  "lineEnding": "\n",
  "header": true,
  "quoting": "minimal",
  "null": "",
  "booleans": ["true", "false"],
  "columns": [
    {"name": "stat", "type": "string", "nullable": false, "description": "Stat key from engine-output.schema.json (dotted for match-level values)."},
    {"name": "side", "type": "enum", "values": ["A", "B"], "nullable": true, "description": "Empty for match-level rows."},
    {"name": "players", "type": "string", "nullable": true, "description": "Display name(s) of the side joined with ' / '."},
    {"name": "numerator", "type": "integer", "nullable": false, "description": "The count for count stats; n for rates."},
    {"name": "denominator", "type": "integer", "nullable": true, "description": "d for rates; empty for counts."},
    {"name": "pct", "type": "integer", "nullable": true, "description": "(200n + d) div 2d; empty for counts and when d = 0."},
    {"name": "display", "type": "string", "nullable": false, "description": "en-US canonical display: '67%', '—' or the count."}
  ],
  "rows": [
    {"stat": "totalPointsWon", "scope": "side"},
    {"stat": "servicePoints", "scope": "side"},
    {"stat": "firstServeIn", "scope": "side"},
    {"stat": "firstServePointsWon", "scope": "side"},
    {"stat": "secondServePointsWon", "scope": "side"},
    {"stat": "secondServeIn", "scope": "side"},
    {"stat": "aces", "scope": "side"},
    {"stat": "doubleFaults", "scope": "side"},
    {"stat": "serviceWinners", "scope": "side"},
    {"stat": "servicePointsWon", "scope": "side"},
    {"stat": "serviceGamesWon", "scope": "side"},
    {"stat": "returnPointsWon", "scope": "side"},
    {"stat": "returnFirstServePointsWon", "scope": "side"},
    {"stat": "returnSecondServePointsWon", "scope": "side"},
    {"stat": "returnGamesWon", "scope": "side"},
    {"stat": "breakPointsSaved", "scope": "side"},
    {"stat": "breakPointsConverted", "scope": "side"},
    {"stat": "winners", "scope": "side"},
    {"stat": "forcedErrors", "scope": "side"},
    {"stat": "unforcedErrors", "scope": "side"},
    {"stat": "penaltyPointsAwarded", "scope": "side"},
    {"stat": "longestPointStreak", "scope": "side"},
    {"stat": "longestGameStreak", "scope": "side"},
    {"stat": "shots.total", "scope": "match"},
    {"stat": "rallyLength.0-4", "scope": "match"},
    {"stat": "rallyLength.5-8", "scope": "match"},
    {"stat": "rallyLength.9+", "scope": "match"},
    {"stat": "rallyLength.unknown", "scope": "match"},
    {"stat": "review.completion", "scope": "match"},
    {"stat": "review.needsReview", "scope": "match"}
  ]
}
