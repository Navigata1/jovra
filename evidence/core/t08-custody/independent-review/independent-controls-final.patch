+@Test func independentBackupFailureRestoresFlagsAndRefusesExternalLinks() async throws {
+    var repo = URL(fileURLWithPath: #filePath)
+    for _ in 0..<7 { repo.deleteLastPathComponent() }
+    let document = try ContractCodec.decode(SessionDocument.self, from: Data(contentsOf: repo.appendingPathComponent("spec/fixtures/sample/jon-vs-alex.session.json")))
+    for afterRename in [false,true] {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: root) }
+        let store = try SessionStore(root: root); try await store.create(document)
+        let library = MediaLibrary(store: store)
+        let folder = try await library.recordingFolder(sessionID: document.id)
+        var file = try await library.reserveOriginalURL(sessionID: document.id, relativePath: "originals/original.mp4")
+        try Data([1,2,3]).write(to: file)
+        var excluded = URLResourceValues(); excluded.isExcludedFromBackup = true; try file.setResourceValues(excluded)
+        let failingStore = try SessionStore(root: root, writeFault: { checkpoint in
+            if case .documentRenamed = checkpoint, afterRename { throw SessionStoreError.durabilityUnconfirmed(5) }
+            if case .temporaryFileFlushed = checkpoint, !afterRename { throw CocoaError(.fileWriteOutOfSpace) }
+        })
+        let failing = MediaLibrary(store: failingStore)
+        await #expect(throws: (any Error).self) { try await failing.includeOriginalsInDeviceBackup(true, sessionID: document.id) }
+        #expect(try await store.load(document.id).storage.includeInDeviceBackup == afterRename)
+        #expect(try file.resourceValues(forKeys: [.isExcludedFromBackupKey]).isExcludedFromBackup == !afterRename)
+        #expect(try Data(contentsOf: file) == Data([1,2,3]))
+        var external = root.appendingPathComponent("external.mp4"); try Data([9]).write(to: external)
+        try external.setResourceValues(excluded)
+        try FileManager.default.createSymbolicLink(at: folder.appendingPathComponent("originals/external-link"), withDestinationURL: external)
+        await #expect(throws: MediaLibraryError.unsafePath) { try await library.includeOriginalsInDeviceBackup(true, sessionID: document.id) }
+        await #expect(throws: MediaLibraryError.unsafePath) { try await library.fileURL(sessionID: document.id, relativePath: "originals/external-link") }
+        #expect(try external.resourceValues(forKeys: [.isExcludedFromBackupKey]).isExcludedFromBackup == true)
+        #expect(try Data(contentsOf: external) == Data([9]))
+    }
+}
